#!/usr/bin/env python3
"""Single public training frontend for Enyo NNUE."""
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


def repo_root() -> Path:
    return Path(__file__).resolve().parent


def expand_path(value: str | Path) -> Path:
    return Path(value).expanduser().resolve()


def expand_user(value: str | Path) -> Path:
    return Path(value).expanduser()


def run(command: list[str]) -> int:
    print(" ".join(command), flush=True)
    proc = subprocess.Popen(command, cwd=repo_root())
    try:
        return proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        raise


def py_script(path: str) -> str:
    return str(repo_root() / path)


def cmd_supervised(args: argparse.Namespace) -> int:
    command = [
        str(expand_user(args.python)),
        py_script("tools/train/train_impl.py"),
        "--data", str(expand_path(args.data)),
        "--out", str(expand_path(args.out)),
        "--objective", args.objective,
        "--huber-beta", str(args.huber_beta),
        "--select-metric", args.select_metric,
        "--wdl-lambda", str(args.wdl_lambda),
        "--epochs", str(args.epochs),
        "--batch-size", str(args.batch_size),
        "--lr", str(args.lr),
        "--weight-decay", str(args.weight_decay),
        "--target-clamp", str(args.target_clamp),
        "--device", args.device,
        "--workers", str(args.workers),
        "--prefetch-factor", str(args.prefetch_factor),
        "--amp", args.amp,
        "--torch-compile" if args.torch_compile else "--no-torch-compile",
        "--dataset-in-memory" if args.dataset_in_memory else "--no-dataset-in-memory",
        "--patience", str(args.patience),
        "--max-rows", str(args.max_rows),
        "--skip-rows", str(args.skip_rows),
        "--val-rows", str(args.val_rows),
        "--trainable", args.trainable,
        "--output-head-features", args.output_head_features,
    ]
    if args.val:
        command += ["--val", str(expand_path(args.val))]
    if args.out_nn:
        command += ["--out-nn", str(expand_path(args.out_nn))]
    if args.init_from_nn:
        command += ["--init-from-nn", str(expand_path(args.init_from_nn))]
    else:
        command += ["--init", args.init]
    for item in args.source_wdl_lambda or []:
        command += ["--source-wdl-lambda", item]
    for item in args.source_loss_weight or []:
        command += ["--source-loss-weight", item]
    return run(command)


def cmd_eval(args: argparse.Namespace) -> int:
    command = [
        str(expand_user(args.python)),
        py_script("tools/validate/eval_dataset.py"),
        "--net", str(expand_path(args.net)),
        "--data", str(expand_path(args.data)),
        "--rows", str(args.rows),
        "--skip", str(args.skip),
        "--batch-size", str(args.batch_size),
        "--device", args.device,
        "--target-clamp", str(args.target_clamp),
    ]
    if args.buckets:
        command.append("--buckets")
    if args.sources:
        command.append("--sources")
    return run(command)


def cmd_pairwise(args: argparse.Namespace) -> int:
    command = [
        str(expand_user(args.python)),
        py_script("tools/train/train_pairwise.py"),
        "--data", str(expand_path(args.data)),
        "--pairs", str(expand_path(args.pairs)),
        "--out", str(expand_path(args.out)),
        "--init", args.init,
        "--epochs", str(args.epochs),
        "--batch-size", str(args.batch_size),
        "--pair-batch-size", str(args.pair_batch_size),
        "--lr", str(args.lr),
        "--weight-decay", str(args.weight_decay),
        "--huber-beta", str(args.huber_beta),
        "--pair-beta", str(args.pair_beta),
        "--pair-weight", str(args.pair_weight),
        "--broad-weight", str(args.broad_weight),
        "--trainable", args.trainable,
        "--steps-per-epoch", str(args.steps_per_epoch),
        "--target-clamp", str(args.target_clamp),
        "--max-target-margin", str(args.max_target_margin),
        "--min-target-margin", str(args.min_target_margin),
        "--device", args.device,
        "--workers", str(args.workers),
        "--max-rows", str(args.max_rows),
        "--skip-rows", str(args.skip_rows),
    ]
    if args.out_nn:
        command += ["--out-nn", str(expand_path(args.out_nn))]
    if args.checkpoint_dir:
        command += ["--checkpoint-dir", str(expand_path(args.checkpoint_dir))]
    command += ["--checkpoint-every", str(args.checkpoint_every)]
    if args.init_from_nn:
        command += ["--init-from-nn", str(expand_path(args.init_from_nn))]
    if args.loss_weight_by_cp:
        command.append("--loss-weight-by-cp")
    if args.project_export_weights_each_step:
        command.append("--project-export-weights-each-step")
    return run(command)


def cmd_move_policy(args: argparse.Namespace) -> int:
    command = [
        str(expand_user(args.python)),
        py_script("tools/train/train_move_policy.py"),
        "--cases", str(expand_path(args.cases)),
        "--out", str(expand_path(args.out)),
        "--hidden", str(args.hidden),
        "--feature-set", args.feature_set,
        "--epochs", str(args.epochs),
        "--lr", str(args.lr),
        "--weight-decay", str(args.weight_decay),
        "--val-fraction", str(args.val_fraction),
        "--seed", str(args.seed),
        "--device", args.device,
        "--print-rate", str(args.print_rate),
    ]
    return run(command)


def add_supervised_parser(sub: argparse._SubParsersAction) -> None:
    parser = sub.add_parser("supervised", help="Train/export from scored rows.")
    parser.add_argument("--data", required=True)
    parser.add_argument("--val")
    parser.add_argument("--out", required=True)
    parser.add_argument("--out-nn")
    parser.add_argument("--init-from-nn")
    parser.add_argument("--init", default="kaiming", choices=["kaiming", "berserk-ish"])
    parser.add_argument("--objective", default="mpe25", choices=["mse", "huber", "mpe25"])
    parser.add_argument("--huber-beta", type=float, default=200.0)
    parser.add_argument("--select-metric", default="loss", choices=["loss", "mse", "mae", "sign"])
    parser.add_argument("--wdl-lambda", type=float, default=0.75)
    parser.add_argument("--source-wdl-lambda", action="append", default=[])
    parser.add_argument("--source-loss-weight", action="append", default=[])
    parser.add_argument("--epochs", type=int, default=80)
    parser.add_argument("--batch-size", type=int, default=4096)
    parser.add_argument("--lr", type=float, default=1e-5)
    parser.add_argument("--weight-decay", type=float, default=1e-6)
    parser.add_argument("--target-clamp", type=float, default=0.0)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--workers", type=int, default=0)
    parser.add_argument("--prefetch-factor", type=int, default=2)
    parser.add_argument("--amp", default="off", choices=["off", "bf16"])
    parser.add_argument("--torch-compile", default=False, action=argparse.BooleanOptionalAction)
    parser.add_argument("--dataset-in-memory", default=False, action=argparse.BooleanOptionalAction)
    parser.add_argument("--patience", type=int, default=0)
    parser.add_argument("--max-rows", type=int, default=0)
    parser.add_argument("--skip-rows", type=int, default=0)
    parser.add_argument("--val-rows", type=int, default=0)
    parser.add_argument("--trainable", default="all", choices=["all", "float-head", "output"])
    parser.add_argument("--output-head-features", default="none", choices=["none", "material-phase"])
    parser.add_argument("--python", default=sys.executable)
    parser.set_defaults(func=cmd_supervised)


def add_eval_parser(sub: argparse._SubParsersAction) -> None:
    parser = sub.add_parser("eval", help="Evaluate a net on packed/Bullet data.")
    parser.add_argument("--net", required=True)
    parser.add_argument("--data", required=True)
    parser.add_argument("--rows", type=int, default=50000)
    parser.add_argument("--skip", type=int, default=0)
    parser.add_argument("--batch-size", type=int, default=4096)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--target-clamp", type=float, default=0.0)
    parser.add_argument("--buckets", action="store_true")
    parser.add_argument("--sources", action="store_true")
    parser.add_argument("--python", default=sys.executable)
    parser.set_defaults(func=cmd_eval)


def add_pairwise_parser(sub: argparse._SubParsersAction) -> None:
    parser = sub.add_parser("pairwise", help="Train from broad rows plus hard child pairs.")
    parser.add_argument("--data", required=True)
    parser.add_argument("--pairs", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--out-nn")
    parser.add_argument("--checkpoint-dir")
    parser.add_argument("--checkpoint-every", type=int, default=0)
    parser.add_argument("--init-from-nn")
    parser.add_argument("--init", default="kaiming", choices=["kaiming", "berserk-ish"])
    parser.add_argument("--epochs", type=int, default=80)
    parser.add_argument("--batch-size", type=int, default=4096)
    parser.add_argument("--pair-batch-size", type=int, default=64)
    parser.add_argument("--lr", type=float, default=1e-5)
    parser.add_argument("--weight-decay", type=float, default=1e-6)
    parser.add_argument("--huber-beta", type=float, default=200.0)
    parser.add_argument("--pair-beta", type=float, default=100.0)
    parser.add_argument("--pair-weight", type=float, default=1.0)
    parser.add_argument("--broad-weight", type=float, default=1.0)
    parser.add_argument("--trainable", default="l2-output",
                        choices=["all", "l1-l2-output", "l2-output", "output"])
    parser.add_argument("--steps-per-epoch", type=int, default=0)
    parser.add_argument("--target-clamp", type=float, default=0.0)
    parser.add_argument("--max-target-margin", type=float, default=800.0)
    parser.add_argument("--min-target-margin", type=float, default=1.0)
    parser.add_argument("--loss-weight-by-cp", action="store_true")
    parser.add_argument("--project-export-weights-each-step", action="store_true")
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--workers", type=int, default=0)
    parser.add_argument("--max-rows", type=int, default=0)
    parser.add_argument("--skip-rows", type=int, default=0)
    parser.add_argument("--python", default=sys.executable)
    parser.set_defaults(func=cmd_pairwise)


def add_move_policy_parser(sub: argparse._SubParsersAction) -> None:
    parser = sub.add_parser("move-policy", help="Train a sidecar move-policy model.")
    parser.add_argument("--cases", required=True)
    parser.add_argument("--out", required=True)
    parser.add_argument("--hidden", type=int, default=128)
    parser.add_argument("--feature-set", choices=["compact", "board"], default="compact")
    parser.add_argument("--epochs", type=int, default=400)
    parser.add_argument("--lr", type=float, default=1e-3)
    parser.add_argument("--weight-decay", type=float, default=1e-4)
    parser.add_argument("--val-fraction", type=float, default=0.25)
    parser.add_argument("--seed", type=int, default=1)
    parser.add_argument("--device", default="cpu")
    parser.add_argument("--print-rate", type=int, default=50)
    parser.add_argument("--python", default=sys.executable)
    parser.set_defaults(func=cmd_move_policy)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Canonical Enyo NNUE training frontend.")
    sub = parser.add_subparsers(dest="command", required=True)
    add_supervised_parser(sub)
    add_eval_parser(sub)
    add_pairwise_parser(sub)
    add_move_policy_parser(sub)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
