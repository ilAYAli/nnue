#!/usr/bin/env bash
set -Eeuo pipefail

# Thin native NNUE loop:
#   ./nnue iterate   train, gate, SPRT, bump build.json on success, stop on failure
#   ./nnue iterate --full-sprt-first  run full SPRT directly for iteration 1 only
#   ./nnue plan      show resolved tools/bullet/train plan
#   ./nnue train     data + train + export
#   ./nnue gates     startpos + static eval + move gate
#   ./nnue sprt      candidate vs reference games
#   ./nnue status    print current run/reference and latest logs

cmd=iterate
SOLO=0
FULL_SPRT_FIRST=0
for arg in "$@"; do
  case "$arg" in
    --solo) SOLO=1 ;;
    --full-sprt-first) FULL_SPRT_FIRST=1 ;;
    iterate|plan|train|gates|sprt|status|help|-h|--help) cmd=$arg ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

BUILD=${BUILD:-build.json}
ARCH=${ARCH:-architecture.json}
DEFAULTS=${DEFAULTS:-defaults.json}
PYTHON=${PYTHON:-.venv/bin/python}
TRAIN_HELPER=${TRAIN_HELPER:-tools/bullet/train}
FORGE=${FORGE:-forge}

ENGINE=${ENGINE:-$HOME/assets/engines/candidate}
REFERENCE_NET=${REFERENCE_NET:-}
CASES=${CASES:-runs/lichess-inacc-miss-blunder-20260612/native760_vs_native123_net_value_bad_move_gate.jsonl}

ROWS=${ROWS:-50000}
SMOKE_GAMES=${SMOKE_GAMES:-400}
SKIP_SMOKE=${SKIP_SMOKE:-0}
SMOKE_FAIL_ELO=${SMOKE_FAIL_ELO:--15.0}
SMOKE_FAIL_LLR=${SMOKE_FAIL_LLR:--0.20}
GAMES=${GAMES:-3000}
CONCURRENCY=${CONCURRENCY:-8}
THREADS=${THREADS:-1}
ITERATIONS=${ITERATIONS:-999}
STOCKFISH_NET=${STOCKFISH_NET:-nn-0ee0657fb25e.nnue}
STOCKFISH_NET_GAMES=${STOCKFISH_NET_GAMES:-500}
STOCKFISH_NET_LEDGER=${STOCKFISH_NET_LEDGER:-benchmarks/stockfish-net.jsonl}
QSPRT=${QSPRT:-tools/validate/sprt_net.sh}
PROMOTED_NET_LINK=${PROMOTED_NET_LINK:-$HOME/assets/nets/candidate.net}
SPRT_ELO0=${SPRT_ELO0:-0.0}
SPRT_ELO1=${SPRT_ELO1:-3.0}
SPRT_ALPHA=${SPRT_ALPHA:-0.10}
SPRT_BETA=${SPRT_BETA:-0.10}

# Loose broken-net gates. These stop obviously bad exports/training before SPRT.
# They are not promotion criteria; SPRT decides whether an iteration is accepted.
MAX_STARTPOS_CP=${MAX_STARTPOS_CP:-300}    # Startpos outside +/-300cp usually means scale/sign/export trouble.
MAX_MAE=${MAX_MAE:-600}                    # Sane native runs are around 300cp on 50k rows; 600+ is suspect.
MIN_SIGN=${MIN_SIGN:-55}                   # 50% is chance; below 55% barely knows which side is better.
MIN_CORR=${MIN_CORR:-0.20}                 # Near zero means eval is mostly unrelated to target.
MAX_ABS_BIAS=${MAX_ABS_BIAS:-300}          # Hundreds of cp offset indicates global bias/scale/sign trouble.
MIN_SLOPE=${MIN_SLOPE:-0.10}               # Near zero means dead/flat eval.
MOVE_GATE_STRICT=${MOVE_GATE_STRICT:-0}    # 0 reports move gate; 1 also fails on worse selected-move counts.

EVENT_HOOK=${EVENT_HOOK:-tools/events/nnue_event_ntfy.sh}
NNUE_NTFY=${NNUE_NTFY:-1}

run=
continue_from=
initialize_from=
reference_name=
run_dir=
log_dir=
candidate_net=
data_file=
reference_net=
train_build=
scratch_confirmed=0
summary_file=
last_sprt_elo=
last_sprt_llr=
last_sprt_line=
last_sprt_command=
last_sprt_log=
last_stockfish_line=
stockfish_result=
stockfish_delta=
stockfish_upper90=

fail() {
  echo "FAILED: $*" >&2
  notify fail "${2:-n/a}" "$*" "" 1
  print_summary || true
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

json() {
  jq -r "$1" "$BUILD"
}

abs_path() {
  case "$1" in
    "~"/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

net_for_name_or_path() {
  [[ -z "$1" || "$1" == "null" ]] && return 1
  case "$1" in
    "~"/*|/*|*.nn|*.net) abs_path "$1" ;;
    *) echo "$HOME/assets/nets/$1.nn" ;;
  esac
}

load_config() {
  [[ $(jq -r 'has("init_net")' "$BUILD") != true ]] \
    || fail "build.json init_net was renamed to initialize_from" config
  run=$(json '.run')
  continue_from=$(json '.continue_from // empty')
  initialize_from=$(json '.initialize_from // empty')
  reference_name=$(json '.reference // empty')
  run_dir="runs/$run"
  log_dir="$run_dir/logs"
  candidate_net="$HOME/assets/nets/$run.nn"
  data_file=$(jq -r --arg run "$run" '
    .data.bullet_output
    // (if (((.data.source_binpack // "") | endswith(".bullet"))
            and ((.data.offset // 0) == 0)
            and ((.data.limit // 0) == 0))
        then .data.source_binpack
        else ("data/bullet/" + $run + ".bullet")
        end)
  ' "$BUILD")
  mkdir -p "$log_dir" runs/logs
  local ref_source="${REFERENCE_NET:-${reference_name:-$continue_from}}"
  if [[ -n "$ref_source" ]]; then
    reference_net=$(net_for_name_or_path "$ref_source")
  else
    reference_net=
  fi
  summary_file=${summary_file:-runs/logs/nnue-iterate-$(date +%Y%m%d_%H%M%S).txt}
}

reference_label() {
  printf '%s\n' "${REFERENCE_NET:-${reference_name:-$continue_from}}"
}

require_training_origin() {
  local stage=${1:-train}
  [[ -n "$continue_from" || -n "$initialize_from" ]] && return 0
  [[ "$scratch_confirmed" == 1 ]] && return 0

  if [[ -t 0 ]]; then
    local answer
    printf 'continue_from not found. Start a new scratch net? [y/N] ' >&2
    IFS= read -r answer || answer=
    case "$answer" in
      y|Y)
        scratch_confirmed=1
        return 0
        ;;
    esac
    fail "continue_from not found; not starting scratch net" "$stage"
  fi

  fail "continue_from not found; set continue_from or run interactively to confirm scratch" "$stage"
}

training_build() {
  require_training_origin train
  train_build="$run_dir/build.resolved.json"
  jq --arg prev "$continue_from" \
    'if $prev == "" then del(.continue_from) else .continue_from = $prev end
     | del(.reference)
     | del(.changed_variables.reference)' \
    "$BUILD" > "$train_build"
  printf '%s\n' "$train_build"
}

notify() {
  local event=$1 phase=$2 message=$3 log=${4:-} user_notify=${5:-0} sprt_json=${6:-null}
  [[ "$NNUE_NTFY" == 1 ]] || return 0
  [[ -x "$EVENT_HOOK" ]] || return 0
  local payload
  payload=$(jq -cn \
    --arg event "$event" \
    --arg run "${run_dir:-runs/${run:-unknown}}" \
    --arg stage "$phase" \
    --arg status "$event" \
    --arg message "$message" \
    --arg log "$log" \
    --arg summary "${summary_file:-}" \
    --argjson user_notify "$user_notify" \
    --argjson sprt "$sprt_json" \
    '{
      event:$event,
      run:$run,
      stage:$stage,
      status:$status,
      message:$message,
      log:$log,
      summary:$summary,
      user_notify:$user_notify,
      critical_failure:($event == "fail"),
      good_news:($event == "iteration_done" and $user_notify)
    }
    | if $sprt == null then . else .sprt = $sprt end')
  NNUE_RUN_EVENT_JSON=$payload "$EVENT_HOOK" >/dev/null 2>&1 || true
}

notify_sprt() {
  local event=$1 phase=$2 message=$3 log=${4:-} user_notify=${5:-0}
  local sprt_json
  sprt_json=$(jq -cn \
    --arg line "${last_sprt_line:-}" \
    --arg elo "${last_sprt_elo:-}" \
    --arg llr "${last_sprt_llr:-}" \
    '{line:$line, elo:$elo, llr:$llr}')
  notify "$event" "$phase" "$message" "$log" "$user_notify" "$sprt_json"
}

section() {
  printf '\n\n  \033[1m▶ %s\033[0m\n' "$1"
  printf '  ────────────────────────────────────────\n'
}

result_pass() {
  printf '  │ %-8s %10s  %s %s\n' "$1" "$2" "$3" "$4"
}

show_config() {
  load_config
  cat <<EOF
run=$run
continue_from=${continue_from:-}
reference=$(reference_label)
engine=$ENGINE
reference_net=$reference_net
candidate_net=$candidate_net
data=$data_file
logs=$log_dir
EOF
}

float_ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }
float_le() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a <= b) }'; }
float_lt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }'; }
float_gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
abs_float_le() { awk -v a="$1" -v b="$2" 'BEGIN { if (a < 0) a = -a; exit !(a <= b) }'; }

sprt_h1_passed() {
  local value upper
  value=$(sed -nE 's/^[[:space:]]*([+-]?[0-9]+([.][0-9]+)?)\/.*/\1/p' <<< "$1")
  upper=$(sed -nE 's/^[[:space:]]*[+-]?[0-9]+([.][0-9]+)?\/([+-]?[0-9]+([.][0-9]+)?).*/\2/p' <<< "$1")
  [[ -n "$value" && -n "$upper" ]] || return 2
  float_ge "$value" "$upper"
}

sprt_llr_value() {
  local value
  value=$(sed -nE 's/^[[:space:]]*([+-]?[0-9]+([.][0-9]+)?)\/.*/\1/p' <<< "$1")
  [[ -n "$value" ]] || return 2
  printf '%s\n' "$value"
}

smoke_sprt_failed() {
  local elo=$1 llr=$2
  local llr_value
  llr_value=$(sprt_llr_value "$llr") || return 2
  if float_le "$elo" "$SMOKE_FAIL_ELO"; then
    return 0
  fi
  if float_lt "$elo" 0 && float_le "$llr_value" "$SMOKE_FAIL_LLR"; then
    return 0
  fi
  return 1
}

full_sprt_label=
full_sprt_pass() {
  if sprt_h1_passed "$last_sprt_llr"; then
    full_sprt_label="H1 reached"
    return 0
  fi

  local llr_value
  llr_value=$(sprt_llr_value "$last_sprt_llr") || fail "could not parse SPRT LLR: $last_sprt_llr" sprt
  if float_gt "$last_sprt_elo" 0 && float_gt "$llr_value" 0; then
    full_sprt_label="positive at cap"
    return 0
  fi
  return 1
}

quote_cmd() {
  printf '%q ' "$@"
  printf '\n'
}

ensure_train_helper_current() {
  [[ -x "$TRAIN_HELPER" ]] || fail "missing trainer helper: $TRAIN_HELPER" train
  [[ "${ALLOW_STALE_TRAIN_HELPER:-0}" == 1 ]] && return 0

  local helper
  helper=$(abs_path "$TRAIN_HELPER")
  local source
  for source in \
    tools/bullet/spike_trainer/Cargo.toml \
    tools/bullet/spike_trainer/src/bin/train.rs \
    tools/bullet/spike_trainer/src/main.rs
  do
    [[ -e "$source" ]] || continue
    if [[ "$source" -nt "$helper" ]]; then
      fail "stale trainer helper: $TRAIN_HELPER is older than $source; rebuild it on the CUDA host" train
    fi
  done
}

ensure_git_identity() {
  git config user.name "Petter Wahlman"
  git config user.email "petter@wahlman.no"
}

metric() {
  awk -F= -v key="$1" '$1 == key { gsub(/%/, "", $2); print $2 }' "$2" | tail -1
}

plan() {
  load_config
  require_training_origin plan
  ensure_train_helper_current
  local build_for_train
  build_for_train=$(training_build)
  "$TRAIN_HELPER" plan --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS"
}

train() {
  load_config
  require_training_origin train
  local build_for_train
  build_for_train=$(training_build)
  local log="$log_dir/01-train-export.log"
  local plan_log="$log_dir/00-plan.log"

  notify phase_start train "training $run" "$log" 0
  ensure_train_helper_current
  section plan
  "$TRAIN_HELPER" plan --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS" | tee "$plan_log" || fail "plan failed for $run" plan
  local train_args=(all --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS")
  if [[ "${FORCE:-0}" == 1 ]]; then
    train_args+=(--force)
  fi
  section train
  "$TRAIN_HELPER" "${train_args[@]}" \
    2>&1 | tee "$log" \
    || fail "train/export failed for $run" train
  notify phase_done train "training/export passed for $run" "$log" 0
}

startpos_gate() {
  load_config
  notify phase_start startpos "startpos gate $run" "$log_dir/02-startpos.log" 0
  section startpos
  show_config
  [[ -x "$ENGINE" ]] || fail "missing engine: $ENGINE" startpos
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" startpos

  local log="$log_dir/02-startpos.log"
  printf 'uci\nsetoption name nnue_file value %s\nisready\nposition startpos\ngo depth 3\nquit\n' "$candidate_net" \
    | "$ENGINE" | tee "$log"

  grep -Eq 'evaluator=(enyo|native)-nnue' "$log" || fail "engine did not load Enyo NNUE" startpos

  local hidden buckets channels cp
  hidden=$(jq -r .hidden "$ARCH")
  buckets=$(jq -r '.runtime_input_buckets // .input_buckets' "$ARCH")
  channels=$(jq -r .feature_channels "$ARCH")
  grep -q "hidden=$hidden" "$log" || fail "hidden mismatch, expected $hidden" startpos
  grep -q "input_buckets=$buckets" "$log" || fail "input_buckets mismatch, expected $buckets" startpos
  grep -q "feature_channels=$channels" "$log" || fail "feature_channels mismatch, expected $channels" startpos

  cp=$(awk '/info depth 3 / { for (i = 1; i <= NF; i++) if ($i == "cp") print $(i + 1) }' "$log" | tail -1)
  [[ -n "$cp" ]] || fail "startpos depth 3 had no cp score" startpos
  abs_float_le "$cp" "$MAX_STARTPOS_CP" || fail "startpos cp $cp outside +/-$MAX_STARTPOS_CP" startpos
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  startpos\n'
  result_pass "cp" "$cp" "|cp| <" "$MAX_STARTPOS_CP"
  printf '  └─────────────────────────────────────\n'
  notify phase_done startpos "startpos passed for $run: cp=$cp" "$log" 0
}

static_gate() {
  load_config
  notify phase_start static_eval "static eval gate $run" "$log_dir/03-static-eval.log" 0
  section static_eval
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" static_eval
  [[ -f "$data_file" ]] || fail "missing data: $data_file" static_eval
  local log="$log_dir/03-static-eval.log"
  "$PYTHON" tools/validate/eval_dataset.py \
    --net "$candidate_net" --data "$data_file" --rows "$ROWS" \
    --batch-size 4096 --device cpu --buckets 2>&1 | tee "$log"
  local mae sign corr bias slope
  mae=$(metric mae "$log")
  sign=$(metric sign "$log")
  corr=$(metric corr "$log")
  bias=$(metric bias "$log")
  slope=$(metric slope "$log")
  [[ -n "$mae" && -n "$sign" && -n "$corr" && -n "$bias" && -n "$slope" ]] || fail "missing static eval metric" static_eval
  float_le "$mae" "$MAX_MAE" || fail "MAE $mae > $MAX_MAE" static_eval
  float_ge "$sign" "$MIN_SIGN" || fail "sign $sign < $MIN_SIGN" static_eval
  float_ge "$corr" "$MIN_CORR" || fail "corr $corr < $MIN_CORR" static_eval
  abs_float_le "$bias" "$MAX_ABS_BIAS" || fail "bias $bias outside +/-$MAX_ABS_BIAS" static_eval
  float_ge "$slope" "$MIN_SLOPE" || fail "slope $slope < $MIN_SLOPE" static_eval
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  static_eval\n'
  result_pass "mae" "$mae" "<" "$MAX_MAE"
  result_pass "sign" "$sign" ">" "$MIN_SIGN"
  result_pass "corr" "$corr" ">" "$MIN_CORR"
  result_pass "bias" "$bias" "|b| <" "$MAX_ABS_BIAS"
  result_pass "slope" "$slope" ">" "$MIN_SLOPE"
  printf '  └─────────────────────────────────────\n'
  notify phase_done static_eval "static_eval passed for $run: mae=$mae sign=$sign corr=$corr bias=$bias slope=$slope" "$log" 0
}

move_gate() {
  load_config
  notify phase_start move_gate "move gate $run" "$log_dir/04-move-gate.log" 0
  section move_gate
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" move_gate
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" move_gate
  if [[ ! -f "$CASES" ]]; then
    [[ "$MOVE_GATE_STRICT" == 1 ]] && fail "missing move gate cases: $CASES" move_gate
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ SKIP\033[0m  move_gate\n'
    result_pass "cases" "missing" "strict" "$MOVE_GATE_STRICT"
    printf '  └─────────────────────────────────────\n'
    notify phase_done move_gate "move_gate skipped for $run: missing cases $CASES" "$log_dir/04-move-gate.log" 0
    return 0
  fi
  local log="$log_dir/04-move-gate.log"
  local summary="$run_dir/move_gate.summary.json"
  "$PYTHON" tools/validate/eval_move_gate.py \
    --cases "$CASES" --engine "$ENGINE" --reference-net "$reference_net" \
    --candidate-net "$candidate_net" --threads 1 --hash 64 \
    --summary-json "$summary" --output "$run_dir/move_gate.jsonl" 2>&1 | tee "$log"
  local ref cand fixed regressed
  ref=$(jq -r .baseline_prefers_best "$summary")
  cand=$(jq -r .candidate_prefers_best "$summary")
  fixed=$(jq -r .fixed "$summary")
  regressed=$(jq -r .regressed "$summary")
  echo "move_gate reference_prefers_best=$ref candidate_prefers_best=$cand fixed=$fixed regressed=$regressed"
  if [[ "$MOVE_GATE_STRICT" == 1 ]]; then
    (( cand >= ref )) || fail "move gate candidate_prefers_best $cand < reference $ref" move_gate
    (( fixed > regressed )) || fail "move gate fixed $fixed <= regressed $regressed" move_gate
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  move_gate\n'
  result_pass "candidate" "$cand" "reference" "$ref"
  result_pass "fixed" "$fixed" "regressed" "$regressed"
  printf '  └─────────────────────────────────────\n'
  notify phase_done move_gate "move_gate passed for $run: candidate=$cand reference=$ref fixed=$fixed regressed=$regressed" "$log" 0
}

gates() {
  startpos_gate
  static_gate
  move_gate
}

forge_run_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE \
    -e 's/^run: id=([^ ]+).*/\1/p' \
    -e 's/.* --run ([^ ]+).*/\1/p' \
    "$log" | tail -1
}

command_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE 's/^\+ //p' "$log" | head -1
}

forge_run_exists() {
  local forge_run=$1
  "$FORGE" status "$forge_run" --json >/dev/null 2>&1
}

read_forge_sprt_status() {
  local forge_run=$1 status_json state fields
  status_json=$("$FORGE" status "$forge_run" --json) || return 1
  state=$(jq -r '.state // empty' <<< "$status_json") || return 1
  case "$state" in
    done|ok|completed) ;;
    *) return 1 ;;
  esac
  fields=$(jq -r '.progress_fields // [] | join(" ")' <<< "$status_json") || return 1
  last_sprt_elo=$(jq -r '.progress_fields[]? | select(startswith("elo=")) | sub("^elo="; "") | sub("^\\+"; "")' <<< "$status_json" | tail -1)
  last_sprt_llr=$(jq -r '.progress_fields[]? | select(startswith("llr=")) | sub("^llr="; "")' <<< "$status_json" | tail -1)
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Forge $forge_run $fields"
}

read_completed_forge_sprt_log() {
  local forge_run=$1 line games done total
  [[ -f "$last_sprt_log" ]] || return 1
  line=$(grep -E 'games=[0-9]+/[0-9]+.*elo=.*llr=' "$last_sprt_log" | tail -1) || return 1
  games=$(sed -nE 's/.*games=([0-9]+)\/([0-9]+).*/\1 \2/p' <<< "$line")
  [[ -n "$games" ]] || return 1
  read -r done total <<< "$games"
  [[ "$done" == "$total" ]] || return 1
  last_sprt_elo=$(sed -nE 's/.*elo=\+?([^ ]+).*/\1/p' <<< "$line")
  last_sprt_llr=$(sed -nE 's/.*llr=([^ ]+( [^ ]+)?) .*/\1/p' <<< "$line")
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Forge $forge_run $line"
}

forge_incomplete_run_for_current_sprt() {
  local label=$1 sprt_games=$2 status_json
  status_json=$("$FORGE" status --json) || {
    [[ -n "$status_json" ]] && jq -e . >/dev/null <<< "$status_json" \
      || fail "could not read Forge active status" sprt
  }
  jq -r --arg prefix "${run}-${label}-${sprt_games}-" '
    def task_count: (.tasks // 0);
    def done_count: (.done // .counts.done // 0);
    (.runs // [])
    | map(select(((.run // "") | startswith($prefix))
        and ((task_count) > 0)
        and ((done_count) < (task_count))))
    | sort_by(.run)
    | last? // {}
    | .run // empty
  ' <<< "$status_json"
}

wait_for_existing_forge_sprt() {
  local forge_run=$1 status_json state manifest progress rc
  if read_forge_sprt_status "$forge_run" || read_completed_forge_sprt_log "$forge_run"; then
    return 0
  fi

  status_json=$("$FORGE" status "$forge_run" --json) \
    || fail "could not read Forge SPRT status for $forge_run" sprt
  state=$(jq -r '.state // empty' <<< "$status_json") || fail "could not parse Forge SPRT status for $forge_run" sprt
  manifest=$(jq -r '.manifest // empty' <<< "$status_json") || fail "could not parse Forge SPRT manifest for $forge_run" sprt
  progress=$(jq -r '.progress_fields // [] | join(" ")' <<< "$status_json") || progress=

  case "$state" in
    stopped|failed|fail)
      local message="Forge SPRT for $run is $state and incomplete: $forge_run"
      [[ -z "$progress" ]] || message+=" $progress"
      message+="; resume or retry it manually, then rerun ./nnue iterate"
      fail "$message" sprt
      ;;
  esac
  [[ -n "$manifest" ]] || fail "cannot wait for Forge SPRT $forge_run: missing manifest" sprt

  printf 'waiting for active Forge SPRT: %s\n' "$forge_run" | tee -a "$last_sprt_log"
  [[ -n "${last_sprt_command:-}" ]] || last_sprt_command="$FORGE wait --manifest $manifest"
  set +e
  "$FORGE" wait --manifest "$manifest" 2>&1 | tee -a "$last_sprt_log"
  rc=${PIPESTATUS[0]}
  set -e
  if read_forge_sprt_status "$forge_run" || read_completed_forge_sprt_log "$forge_run"; then
    return 0
  fi
  return "$rc"
}

run_sprt_once() {
  local label=$1 sprt_games=$2 stage=$3
  last_sprt_log="$log_dir/05-${label}-${sprt_games}.log"
  notify phase_start "$stage" "SPRT $label $run vs $(reference_label)" "$last_sprt_log" 0
  section "$label"

  if [[ "$SOLO" != 1 ]]; then
    local forge_run
    local remote_engine="~/assets/engines/${ENGINE##*/}"
    local remote_candidate_net="~/assets/nets/${candidate_net##*/}"
    local remote_reference_net="~/assets/nets/${reference_net##*/}"
    forge_run=$(forge_run_from_log "$last_sprt_log" || true)
    if [[ -n "$forge_run" ]] && ! forge_run_exists "$forge_run"; then
      printf 'ignoring stale Forge run from log: %s\n' "$forge_run" | tee -a "$last_sprt_log"
      forge_run=
    fi
    [[ -n "$forge_run" ]] || forge_run=$(forge_incomplete_run_for_current_sprt "$label" "$sprt_games" || true)
    if [[ -n "$forge_run" ]]; then
      last_sprt_command=$(command_from_log "$last_sprt_log" || true)
      wait_for_existing_forge_sprt "$forge_run" \
        || fail "Forge SPRT did not complete for $run ($forge_run); resume or retry it manually, then rerun ./nnue iterate" sprt
      return 0
    fi

    forge_run="${run}-${label}-${sprt_games}-$(date +%Y%m%d-%H%M%S)"
    [[ -x "$ENGINE" ]] || fail "missing engine: $ENGINE" sprt
    [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt
    [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
    local forge_cmd=(
      "$FORGE" sprt
      --run "$forge_run"
      --candidate "$remote_engine"
      --reference "$remote_engine"
      --candidate-uci "nnue_file=$remote_candidate_net"
      --reference-uci "nnue_file=$remote_reference_net"
      --games "$sprt_games"
      --elo0 "$SPRT_ELO0"
      --elo1 "$SPRT_ELO1"
      --alpha "$SPRT_ALPHA"
      --beta "$SPRT_BETA"
    )
    local hypothesis
    hypothesis=$(json '.hypothesis // empty')
    [[ -z "$hypothesis" ]] || forge_cmd+=(--comment "$hypothesis")
    last_sprt_command=$(quote_cmd "${forge_cmd[@]}")
    if ! "${forge_cmd[@]}" 2>&1 | tee "$last_sprt_log"; then
      fail "could not launch Forge SPRT for $run ($forge_run)" sprt
    fi

    wait_for_existing_forge_sprt "$forge_run" \
      || fail "Forge SPRT did not complete for $run ($forge_run); resume or retry it manually, then rerun ./nnue iterate" sprt
    return 0
  fi

  local sprt_cmd=(
    sprt
    --concurrency "$CONCURRENCY"
    --threads "$THREADS"
    --reference "$ENGINE"
    --candidate "$ENGINE"
    --reference-uci "nnue_file=$reference_net"
    --candidate-uci "nnue_file=$candidate_net"
    --games "$sprt_games"
    --elo0 "$SPRT_ELO0"
    --elo1 "$SPRT_ELO1"
    --alpha "$SPRT_ALPHA"
    --beta "$SPRT_BETA"
  )
  last_sprt_command=$(quote_cmd "${sprt_cmd[@]}")
  "${sprt_cmd[@]}" \
    2>&1 | tee "$last_sprt_log" \
    || fail "SPRT command failed for $run" sprt

  last_sprt_line=$(grep -E '^\[[[:space:]]*[0-9]+/[0-9]+\] Elo' "$last_sprt_log" | tail -1)
  [[ -n "$last_sprt_line" ]] || fail "could not parse SPRT output" sprt
  last_sprt_elo=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "Elo") { print $(i + 1); exit } }' <<< "$last_sprt_line")
  last_sprt_llr=$(sed -nE 's/.*[Ll][Ll][Rr][ =:]+([+-]?[0-9.]+\/[+-]?[0-9.]+).*/\1/p' <<< "$last_sprt_line" | tail -1)
  [[ -n "$last_sprt_elo" ]] || fail "could not parse SPRT Elo" sprt
  [[ -n "$last_sprt_llr" ]] || fail "could not parse SPRT LLR" sprt
}

sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  if [[ "$SKIP_SMOKE" != 1 ]]; then
    run_sprt_once smoke "$SMOKE_GAMES" sprt_smoke
    if sprt_h1_passed "$last_sprt_llr"; then
      printf '  ┌─────────────────────────────────────\n'
      printf '  │ \033[1;32m✓ PASS\033[0m  smoke (H1 reached)\n'
      result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
      printf '  └─────────────────────────────────────\n'
      notify_sprt phase_done sprt "SPRT smoke passed for $run: $last_sprt_line" "$last_sprt_log" 0
      return 0
    fi
    local smoke_rc
    if smoke_sprt_failed "$last_sprt_elo" "$last_sprt_llr"; then
      return 1
    else
      smoke_rc=$?
      if (( smoke_rc == 2 )); then
        fail "could not parse smoke SPRT LLR: $last_sprt_llr" sprt
      fi
    fi
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ CONTINUE\033[0m  smoke → full SPRT\n'
    result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
    printf '  └─────────────────────────────────────\n'
    notify_sprt phase_done sprt_smoke "SPRT smoke inconclusive for $run: $last_sprt_line" "$last_sprt_log" 0
  else
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ SKIP\033[0m  smoke → full SPRT\n'
    printf '  └─────────────────────────────────────\n'
  fi

  run_sprt_once sprt "$GAMES" sprt
  full_sprt_pass || return 1
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify_sprt phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}
full_sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  run_sprt_once sprt "$GAMES" sprt
  full_sprt_pass || return 1
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify_sprt phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}

next_run_name() {
  if [[ "$1" =~ ^(.*-v|.*v)([0-9]+)$ ]]; then
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]} + 1))"
  elif [[ "$1" =~ ^(.+-rc)([0-9]+)$ ]]; then
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]} + 1))"
  elif [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s%d.%d.%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))" "$((10#${BASH_REMATCH[4]} + 1))"
  else
    fail "cannot bump run name: $1" iterate
  fi
}

next_promoted_run_name() {
  if [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)-rc[0-9]+$ ]]; then
    printf '%s%d.%d.0-rc1\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]} + 1))"
  else
    next_run_name "$1"
  fi
}

commit_and_bump_build_json() {
  local result=$1 accepted=$2 elo=$3 llr=$4 command=$5 details=$6
  local next next_base subject hypothesis
  local -a commit_paths=("$BUILD" "$ARCH")
  if [[ "$result" == PASS ]]; then
    subject="${accepted}.nn: Elo ${elo},LLR ${llr}"
    next_base=$accepted
    next=$(next_promoted_run_name "$accepted")
  else
    subject="${accepted}.nn: rejected: Elo ${elo},LLR ${llr}"
    next_base=${continue_from:-}
    next=$(next_run_name "$accepted")
  fi
  hypothesis=$(jq -r '.hypothesis // empty' "$BUILD" 2>/dev/null || printf '')
  [[ -f "$STOCKFISH_NET_LEDGER" ]] && commit_paths+=("$STOCKFISH_NET_LEDGER")

  git commit --only \
    -m "$subject" \
    -m "Hypothesis:
$hypothesis

Forge command:
$command

Result:
$details" \
    -- "${commit_paths[@]}" || return

  if [[ "$result" == PASS ]]; then
    ln -sfn "$accepted.nn" "$PROMOTED_NET_LINK" || return
  fi

  local tmp
  tmp=$(mktemp)
  if [[ "$result" == PASS ]]; then
    jq \
      --arg run "$next" \
      --arg continue_from "$next_base" \
      '.run = $run
       | if $continue_from == "" then del(.continue_from) else .continue_from = $continue_from end
       | if ((.data.offset? | type) == "number") and ((.data.limit? | type) == "number") then
           .data.offset = (.data.offset + .data.limit)
         else
           .
         end
       | del(.reference)
       | del(.initialize_from)
       | del(.changed_variables.reference)' \
      "$BUILD" > "$tmp"
  else
    jq \
      --arg run "$next" \
      --arg continue_from "$next_base" \
      '.run = $run
       | if $continue_from == "" then
           .
         else
           .continue_from = $continue_from
           | del(.reference)
           | del(.initialize_from)
           | del(.changed_variables.reference)
         end
       | if ((.data.offset? | type) == "number") and ((.data.limit? | type) == "number") then
           .data.offset = (.data.offset + .data.limit)
         else
           .
         end' \
      "$BUILD" > "$tmp"
  fi
  mv "$tmp" "$BUILD"
  echo "updated $BUILD: run=$next"
}

bump_build_json() {
  commit_and_bump_build_json PASS "$@"
}

fail_build_json() {
  commit_and_bump_build_json FAIL "$@"
}

commit_failed_iteration() {
  fail_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-failed sprt}" \
    || fail "failed build.json commit failed for $run" iterate
  record_iteration FAIL "rejected; build.json advanced"
  notify fail iterate "rejected $run: ${last_sprt_line:-sprt failed}" "$summary_file" 1
  print_summary || true
}

record_iteration() {
  local result=$1
  local detail=$2
  {
    echo "$run vs $(reference_label): $result"
    echo "  $detail"
    [[ -n "${last_sprt_line:-}" ]] && echo "  $last_sprt_line"
  } >> "$summary_file"
}

print_summary() {
  [[ -f "${summary_file:-}" ]] || return 0
  section "iteration summary"
  cat "$summary_file"
  echo "summary_file=$summary_file"
}

promoted_net_name() {
  local target
  [[ -L "$PROMOTED_NET_LINK" ]] || return 1
  target=$(readlink "$PROMOTED_NET_LINK") || return 1
  target=${target##*/}
  [[ "$target" == *.nn ]] || return 1
  printf '%s\n' "${target%.nn}"
}

latest_stockfish_result() {
  local candidate=$1 engine=$2
  [[ -s "$STOCKFISH_NET_LEDGER" ]] || return 1
  jq -sc \
    --arg candidate "$candidate" \
    --arg engine "$engine" \
    --arg reference "${STOCKFISH_NET##*/}" \
    '[.[] | select(
        .candidate == $candidate
        and .engine == $engine
        and .reference == $reference
      )] | last // empty' \
    "$STOCKFISH_NET_LEDGER"
}

run_stockfish_benchmark() {
  local candidate=$1
  GAMES="$STOCKFISH_NET_GAMES" STOCKFISH_NET="$STOCKFISH_NET" "$QSPRT" \
    --candidate "$candidate.nn" \
    || fail "Stockfish net benchmark failed for $candidate" stockfish_net_sprt

  stockfish_result=$(tail -n 1 "$STOCKFISH_NET_LEDGER")
  jq -e \
    --arg candidate "$candidate" \
    --arg reference "${STOCKFISH_NET##*/}" \
    --argjson games "$STOCKFISH_NET_GAMES" \
    '.candidate == $candidate
     and .reference == $reference
     and .games == $games
     and (.elo | type) == "number"
     and (.ci | type) == "number"' \
    <<< "$stockfish_result" >/dev/null \
    || fail "invalid Stockfish benchmark result for $candidate" stockfish_net_sprt
}

stockfish_net_gate() {
  local candidate=$1 champion candidate_result champion_result engine
  local candidate_elo candidate_ci champion_elo champion_ci

  stockfish_delta=
  stockfish_upper90=

  section "Stockfish promotion gate"
  run_stockfish_benchmark "$candidate"
  candidate_result=$stockfish_result
  engine=$(jq -r '.engine' <<< "$candidate_result")

  if ! champion=$(promoted_net_name); then
    last_stockfish_line="Stockfish gate: no existing champion; benchmarked $candidate"
    return 0
  fi

  champion_result=$(latest_stockfish_result "$champion" "$engine")
  if [[ -z "$champion_result" ]]; then
    run_stockfish_benchmark "$champion"
    champion_result=$stockfish_result
    [[ $(jq -r '.engine' <<< "$champion_result") == "$engine" ]] \
      || fail "Stockfish champion benchmark used a different engine" stockfish_net_sprt
  fi

  candidate_elo=$(jq -r '.elo' <<< "$candidate_result")
  candidate_ci=$(jq -r '.ci' <<< "$candidate_result")
  champion_elo=$(jq -r '.elo' <<< "$champion_result")
  champion_ci=$(jq -r '.ci' <<< "$champion_result")
  # Convert combined 95% CI half-widths to a one-sided 90% upper bound.
  read -r stockfish_delta stockfish_upper90 < <(awk \
    -v candidate="$candidate_elo" -v champion="$champion_elo" \
    -v candidate_ci="$candidate_ci" -v champion_ci="$champion_ci" \
    'BEGIN {
      delta = candidate - champion
      combined_ci = sqrt(candidate_ci * candidate_ci + champion_ci * champion_ci)
      printf "%.1f %.1f\n", delta, delta + 0.654 * combined_ci
    }')

  last_stockfish_line="Stockfish gate: $candidate ${candidate_elo} vs $champion ${champion_elo}; delta=${stockfish_delta}, upper90=${stockfish_upper90}"
  echo "$last_stockfish_line"
  float_lt "$stockfish_upper90" 0 && return 1

  local sprt_json
  sprt_json=$(jq -c --arg line "$last_stockfish_line" '
    {
      line: $line,
      elo: (.elo | tostring),
      llr: ("\(.llr)/\(.llr_bound)")
    }' <<< "$candidate_result")
  notify iteration_done stockfish_net_sprt "$last_stockfish_line" "$STOCKFISH_NET_LEDGER" 0 "$sprt_json"
}

iterate() {
  need jq
  need git
  ensure_git_identity
  for ((i = 1; i <= ITERATIONS; i++)); do
    load_config
    section "iteration $i"
    show_config
    notify phase_start iterate "starting iteration $i: $run" "$summary_file" 0
    if (( FULL_SPRT_FIRST != 1 || i != 1 )); then
      train || fail "train failed for $run" train
      gates || fail "gates failed for $run" gates
    fi
    if ! stockfish_net_gate "$run"; then
      last_sprt_elo=$stockfish_delta
      last_sprt_llr="Stockfish upper90=$stockfish_upper90"
      last_sprt_command="$QSPRT --candidate $run.nn"
      last_sprt_line=$last_stockfish_line
      commit_failed_iteration
      break
    fi
    if (( FULL_SPRT_FIRST == 1 && i == 1 )); then
      if ! full_sprt_gate; then
        commit_failed_iteration
        break
      fi
    else
      if ! sprt_gate; then
        commit_failed_iteration
        break
      fi
    fi
    bump_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-passed sprt}" \
      || fail "build.json commit failed for $run" iterate
    record_iteration PASS "accepted; build.json advanced"
    notify iteration_done iterate "accepted $run: ${last_sprt_line:-sprt passed}" "$summary_file" 1
  done
  print_summary
}

status() {
  load_config
  show_config
  echo
  pgrep -af '(^|[[:space:]])\.?/nnue([[:space:]]|$)|tools/bullet/train|enyo-bullet-spike|sprt|fastchess' || true
  echo
  find "$log_dir" -maxdepth 1 -type f 2>/dev/null | sort | tail -10
}

help() {
  cat <<'EOF'
Usage:
  ./nnue iterate   # main command: train, gate, SPRT, bump build.json on pass
  ./nnue iterate --full-sprt-first
  ./nnue plan
  ./nnue train
  ./nnue gates
  ./nnue sprt
  ./nnue sprt --solo
  ./nnue status

Useful overrides:
  ITERATIONS=5 ./nnue iterate
  STOCKFISH_NET_EVERY=3 STOCKFISH_NET_GAMES=500 ./nnue iterate
  ./nnue iterate --full-sprt-first  # first iteration skips train/gates/smoke
  REFERENCE_NET=$HOME/assets/nets/other.nn ./nnue sprt
  SKIP_SMOKE=1 GAMES=800 ./nnue iterate
  SMOKE_GAMES=400 SMOKE_FAIL_ELO=-15 SMOKE_FAIL_LLR=-0.20 ./nnue sprt
  GAMES=5000 CONCURRENCY=8 THREADS=1 ./nnue sprt
  FORCE=1 ./nnue train
  MOVE_GATE_STRICT=1 ./nnue gates

Safety:
  continuation runs must set build.json continue_from
  missing continue_from asks before scratch training in an interactive terminal
  non-interactive missing continue_from fails before training
EOF
}

case "$cmd" in
  iterate) iterate ;;
  plan) plan ;;
  train) train ;;
  gates) gates ;;
  sprt) sprt_gate ;;
  status) status ;;
  help|-h|--help) help ;;
  *) fail "unknown command: $cmd" ;;
esac
