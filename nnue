forge_run_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE \
    -e 's/^run: id=([^ ]+).*/\1/p' \
    -e 's/.* --run ([^ ]+).*/\1/p' \
    "$log" | tail -1
}

command_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE 's/^\+ //p' "$log" | head -1
}

forge_run_exists() {
  local forge_run=$1
  "$FORGE" status "$forge_run" --json >/dev/null 2>&1
}

read_forge_sprt_status() {
  local forge_run=$1 status_json state fields
  status_json=$("$FORGE" status "$forge_run" --json) || return 1
  state=$(jq -r '.state // empty' <<< "$status_json") || return 1
  case "$state" in
    done|ok|completed) ;;
    *) return 1 ;;
  esac
  fields=$(jq -r '.progress_fields // [] | join(" ")' <<< "$status_json") || return 1
  last_sprt_elo=$(jq -r '.progress_fields[]? | select(startswith("elo=")) | sub("^elo="; "") | sub("^\\+"; "")' <<< "$status_json" | tail -1)
  last_sprt_llr=$(jq -r '.progress_fields[]? | select(startswith("llr=")) | sub("^llr="; "")' <<< "$status_json" | tail -1)
  last_sprt_ci=$(jq -r '.progress_fields[]? | select(startswith("ci=")) | sub("^ci="; "")' <<< "$status_json" | tail -1)
  last_sprt_los=$(jq -r '.progress_fields[]? | select(startswith("los=")) | sub("^los="; "") | sub("%$"; "")' <<< "$status_json" | tail -1)
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Forge $forge_run $fields"
}

read_completed_forge_sprt_log() {
  local forge_run=$1 line games done total
  [[ -f "$last_sprt_log" ]] || return 1
  line=$(grep -E 'games=[0-9]+/[0-9]+.*elo=.*llr=' "$last_sprt_log" | tail -1) || return 1
  games=$(sed -nE 's/.*games=([0-9]+)\/([0-9]+).*/\1 \2/p' <<< "$line")
  [[ -n "$games" ]] || return 1
  read -r done total <<< "$games"
  [[ "$done" == "$total" ]] || return 1
  last_sprt_elo=$(sed -nE 's/.*elo=\+?([^ ]+).*/\1/p' <<< "$line")
  last_sprt_llr=$(sed -nE 's/.*llr=([^ ]+( [^ ]+)?) .*/\1/p' <<< "$line")
  last_sprt_ci=$(sed -nE 's/.*ci=([0-9.]+).*/\1/p' <<< "$line")
  last_sprt_los=$(sed -nE 's/.*los=([0-9.]+)%?.*/\1/p' <<< "$line")
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Forge $forge_run $line"
}

forge_incomplete_run_for_current_sprt() {
  local label=$1 sprt_games=$2 status_json
  status_json=$("$FORGE" status --json) || {
    [[ -n "$status_json" ]] && jq -e . >/dev/null <<< "$status_json" \
      || fail "could not read Forge active status" sprt
  }
  jq -r --arg prefix "${run}-${label}-${sprt_games}-" '
    def task_count: (.tasks // 0);
    def done_count: (.done // .counts.done // 0);
    (.runs // [])
    | map(select(((.run // "") | startswith($prefix))
        and ((task_count) > 0)
        and ((done_count) < (task_count))))
    | sort_by(.run)
    | last? // {}
    | .run // empty
  ' <<< "$status_json"
}

wait_for_existing_forge_sprt() {
  local forge_run=$1 status_json state manifest progress rc
  if read_forge_sprt_status "$forge_run" || read_completed_forge_sprt_log "$forge_run"; then
    return 0
  fi

  status_json=$("$FORGE" status "$forge_run" --json) \
    || fail "could not read Forge SPRT status for $forge_run" sprt
  state=$(jq -r '.state // empty' <<< "$status_json") || fail "could not parse Forge SPRT status for $forge_run" sprt
  manifest=$(jq -r '.manifest // empty' <<< "$status_json") || fail "could not parse Forge SPRT manifest for $forge_run" sprt
  progress=$(jq -r '.progress_fields // [] | join(" ")' <<< "$status_json") || progress=

  case "$state" in
    stopped|failed|fail)
      local message="Forge SPRT for $run is $state and incomplete: $forge_run"
      [[ -z "$progress" ]] || message+=" $progress"
      message+="; resume or retry it manually, then rerun ./nnue iterate"
      fail "$message" sprt
      ;;
  esac
  printf 'waiting for active Forge SPRT: %s\n' "$forge_run" | tee -a "$last_sprt_log"
  [[ -n "${last_sprt_command:-}" ]] || last_sprt_command="$FORGE status $forge_run --json"

  # Poll rather than block, so the staged checkpoints can stop a hopeless run
  # before it burns its full game budget. One run, cumulative statistics.
  local triage_done=0 played verdict
  local waited=0
  while :; do
    if [[ "$SPRT_MAX_WAIT_SECONDS" -gt 0 && "$waited" -ge "$SPRT_MAX_WAIT_SECONDS" ]]; then
      fail "Forge SPRT $forge_run did not finish within ${SPRT_MAX_WAIT_SECONDS}s" sprt
    fi
    if read_forge_sprt_status "$forge_run" || read_completed_forge_sprt_log "$forge_run"; then
      return 0
    fi
    status_json=$("$FORGE" status "$forge_run" --json 2>/dev/null) || status_json=
    if [[ -n "$status_json" ]]; then
      state=$(jq -r '.state // empty' <<< "$status_json")
      case "$state" in
        stopped|failed|fail)
          fail "Forge SPRT for $run is $state and incomplete: $forge_run; resume or retry it manually, then rerun ./nnue iterate" sprt
          ;;
      esac
      played=$(jq -r '.progress_fields[]? | select(startswith("games=")) | sub("^games="; "") | split("/")[0]' <<< "$status_json" | tail -1)
      last_sprt_elo=$(jq -r '.progress_fields[]? | select(startswith("elo=")) | sub("^elo="; "") | sub("^\\+"; "")' <<< "$status_json" | tail -1)
      last_sprt_llr=$(jq -r '.progress_fields[]? | select(startswith("llr=")) | sub("^llr="; "")' <<< "$status_json" | tail -1)
      last_sprt_ci=$(jq -r '.progress_fields[]? | select(startswith("ci=")) | sub("^ci="; "")' <<< "$status_json" | tail -1)

      last_sprt_los=$(jq -r '.progress_fields[]? | select(startswith("los=")) | sub("^los="; "") | sub("%$"; "")' <<< "$status_json" | tail -1)

      verdict=
      if [[ "$SKIP_SMOKE" != 1 && -n "$played" && -n "$last_sprt_elo" ]]; then
        # Checkpoint 1: a catastrophically bad net, rejected on effect size
        # because the LLR bound is far too slow to see it.
        if (( triage_done == 0 )) && [[ "$played" -ge "$SMOKE_GAMES" ]]; then
          triage_done=1
          if smoke_sprt_failed "$last_sprt_elo" "$last_sprt_llr"; then
            verdict="reject:triage at $played games, elo $last_sprt_elo"
          fi
        fi
      fi
      if [[ -n "$verdict" ]]; then
        printf 'stopping Forge SPRT early, %s\n' "${verdict#*:}" | tee -a "$last_sprt_log"
        "$FORGE" stop --force "$forge_run" </dev/null 2>&1 | tee -a "$last_sprt_log" || true
        last_sprt_line="Forge $forge_run stopped early, ${verdict#*:} (elo $last_sprt_elo los $last_sprt_los%)"
        return 3
      fi
    fi
    sleep "$SPRT_POLL_SECONDS"
    waited=$((waited + SPRT_POLL_SECONDS))
  done
}

run_sprt_once() {
  local label=$1 sprt_games=$2 stage=$3 hypothesis
  hypothesis=$(jq -r '.hypothesis // empty' "$BUILD" 2>/dev/null || printf '')
  last_sprt_log="$log_dir/05-${label}-${sprt_games}.log"
  notify phase_start "$stage" "SPRT $label $run vs $(reference_label)" "$last_sprt_log" 0
  section "$label"

  if [[ "$SOLO" != 1 ]]; then
    local forge_run
    local remote_engine="~/assets/engines/${ENGINE##*/}"
    local remote_candidate_net="~/assets/nets/${candidate_net##*/}"
    local remote_reference_net="~/assets/nets/${reference_net##*/}"
    forge_run=$(forge_run_from_log "$last_sprt_log" || true)
    if [[ -n "$forge_run" ]] && ! forge_run_exists "$forge_run"; then
      printf 'ignoring stale Forge run from log: %s\n' "$forge_run" | tee -a "$last_sprt_log"
      forge_run=
    fi
    [[ -n "$forge_run" ]] || forge_run=$(forge_incomplete_run_for_current_sprt "$label" "$sprt_games" || true)
    if [[ -n "$forge_run" ]]; then
      last_sprt_command=$(command_from_log "$last_sprt_log" || true)
      local wait_rc=0
      wait_for_existing_forge_sprt "$forge_run" || wait_rc=$?
      (( wait_rc == 3 )) && return 3
      (( wait_rc == 0 )) \
        || fail "Forge SPRT did not complete for $run ($forge_run); resume or retry it manually, then rerun ./nnue iterate" sprt
      return 0
    fi

    forge_run="${run}-${label}-${sprt_games}-$(date +%Y%m%d-%H%M%S)"
    [[ -x "$ENGINE" ]] || fail "missing engine: $ENGINE" sprt
    [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt
    [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
    local forge_cmd=(
      "$FORGE" sprt
      --run "$forge_run"
      --candidate "$remote_engine"
      --reference "$remote_engine"
      --candidate-net "$remote_candidate_net"
      --reference-net "$remote_reference_net"
      --games "$sprt_games"
      --elo0 "$SPRT_ELO0"
      --elo1 "$SPRT_ELO1"
      --alpha "$SPRT_ALPHA"
      --beta "$SPRT_BETA"
    )
    forge_cmd+=(--comment "$run vs $(reference_label): $hypothesis")
    last_sprt_command=$(quote_cmd "${forge_cmd[@]}")
    if ! "${forge_cmd[@]}" 2>&1 | tee "$last_sprt_log"; then
      fail "could not launch Forge SPRT for $run ($forge_run)" sprt
    fi

    local wait_rc=0
    wait_for_existing_forge_sprt "$forge_run" || wait_rc=$?
    (( wait_rc == 3 )) && return 3
    (( wait_rc == 0 )) \
      || fail "Forge SPRT did not complete for $run ($forge_run); resume or retry it manually, then rerun ./nnue iterate" sprt
    return 0
  fi

  local sprt_cmd=(
    sprt
    --concurrency "$CONCURRENCY"
    --threads "$THREADS"
    --reference "$ENGINE"
    --candidate "$ENGINE"
    --reference-net "$reference_net"
    --candidate-net "$candidate_net"
    --games "$sprt_games"
    --elo0 "$SPRT_ELO0"
    --elo1 "$SPRT_ELO1"
    --alpha "$SPRT_ALPHA"
    --beta "$SPRT_BETA"
  )
  last_sprt_command=$(quote_cmd "${sprt_cmd[@]}")
  "${sprt_cmd[@]}" \
    2>&1 | tee "$last_sprt_log" \
    || fail "SPRT command failed for $run" sprt

  last_sprt_line=$(grep -E '^\[[[:space:]]*[0-9]+/[0-9]+\] Elo' "$last_sprt_log" | tail -1)
  [[ -n "$last_sprt_line" ]] || fail "could not parse SPRT output" sprt
  last_sprt_elo=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "Elo") { print $(i + 1); exit } }' <<< "$last_sprt_line")
  last_sprt_llr=$(sed -nE 's/.*[Ll][Ll][Rr][ =:]+([+-]?[0-9.]+\/[+-]?[0-9.]+).*/\1/p' <<< "$last_sprt_line" | tail -1)
  last_sprt_ci=$(sed -nE 's/.*(ci=|\+\/-[ ]*)([0-9.]+).*/\2/p' <<< "$last_sprt_line" | tail -1)
  [[ -n "$last_sprt_elo" ]] || fail "could not parse SPRT Elo" sprt
  [[ -n "$last_sprt_llr" ]] || fail "could not parse SPRT LLR" sprt
}

sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  if [[ "$SKIP_SMOKE" == 1 ]]; then
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ SKIP\033[0m  checkpoints disabled, full %s games\n' "$GAMES"
    printf '  └─────────────────────────────────────\n'
  else
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ RUN\033[0m  %s games, Forge decides on llr (elo1=%s)\n' \
      "$GAMES" "$SPRT_ELO1"
    printf '  └─────────────────────────────────────\n'
  fi

  local sprt_rc=0
  if [[ "$SKIP_SMOKE" != 1 && "$GAMES" -lt "$PROMOTION_GAMES" ]]; then
    run_sprt_once screen "$GAMES" sprt || sprt_rc=$?
    (( sprt_rc == 0 )) || return 1
    if smoke_sprt_failed "$last_sprt_elo"; then
      printf '  ┌─────────────────────────────────────\n'
      printf '  │ \033[1;31m✗ REJECT\033[0m  catastrophic screen: %s\n' "${last_sprt_line:-result unavailable}"
      printf '  └─────────────────────────────────────\n'
      notify_sprt phase_done sprt "SPRT rejected for $run: ${last_sprt_line:-result unavailable}" "$last_sprt_log" 1
      return 1
    fi
  fi

  sprt_rc=0
  run_sprt_once sprt "$PROMOTION_GAMES" sprt || sprt_rc=$?
  if (( sprt_rc == 3 )); then
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;31m✗ REJECT\033[0m  %s\n' "$last_sprt_line"
    printf '  └─────────────────────────────────────\n'
    notify_sprt phase_done sprt "SPRT stopped early for $run: $last_sprt_line" "$last_sprt_log" 1
    return 1
  fi
  (( sprt_rc == 0 )) || return 1
  if ! full_sprt_pass; then
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ INCONCLUSIVE\033[0m  %s\n' "${last_sprt_line:-result unavailable}"
    printf '  └─────────────────────────────────────\n'
    notify_sprt phase_done sprt "SPRT inconclusive for $run: ${last_sprt_line:-result unavailable}" "$last_sprt_log" 0
    return 2
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify_sprt phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}
full_sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  run_sprt_once sprt "$GAMES" sprt
  if ! full_sprt_pass; then
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ INCONCLUSIVE\033[0m  %s\n' "${last_sprt_line:-result unavailable}"
    printf '  └─────────────────────────────────────\n'
    notify_sprt phase_done sprt "SPRT inconclusive for $run: ${last_sprt_line:-result unavailable}" "$last_sprt_log" 0
    return 2
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify_sprt phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}

sprt_command() {
  local sprt_rc=0
  sprt_gate || sprt_rc=$?
  if (( sprt_rc == 0 )); then
    notify_sprt done sprt "SPRT completed for $run: ${last_sprt_line:-result unavailable}" \
      "$last_sprt_log" 1
    return 0
  fi

  if (( sprt_rc == 2 )); then
    notify_sprt done sprt "SPRT inconclusive for $run: ${last_sprt_line:-result unavailable}" \
      "$last_sprt_log" 1
    return 2
  fi

  notify_sprt fail sprt "SPRT rejected $run: ${last_sprt_line:-result unavailable}" \
    "$last_sprt_log" 1
  return 1
}

next_run_name() {
  if [[ "$1" =~ ^(.*-v|.*v)([0-9]+)$ ]]; then
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]} + 1))"
  elif [[ "$1" =~ ^(.+-rc)([0-9]+)$ ]]; then
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]} + 1))"
  elif [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s%d.%d.%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))" "$((10#${BASH_REMATCH[4]} + 1))"
  else
    fail "cannot bump run name: $1" iterate
  fi
}

next_promoted_run_name() {
  if [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)-rc[0-9]+$ ]]; then
    printf '%s%d.%d.0-rc1\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]} + 1))"
  else
    next_run_name "$1"
  fi
}

commit_and_bump_build_json() {
  local result=$1 accepted=$2 elo=$3 llr=$4 command=$5 details=$6
  local next next_base subject hypothesis
  local -a commit_paths=("$BUILD" "$ARCH")
  [[ "$AUTO_ADVANCE" == 0 || "$AUTO_ADVANCE" == 1 ]] \
    || fail "AUTO_ADVANCE must be 0 or 1, got: $AUTO_ADVANCE" iterate
  if [[ "$result" == PASS ]]; then
    subject="${accepted}.nn: Elo ${elo},LLR ${llr}"
  else
    subject="${accepted}.nn: rejected: Elo ${elo},LLR ${llr}"
  fi
  hypothesis=$(jq -r '.hypothesis // empty' "$BUILD" 2>/dev/null || printf '')
  if [[ -n "$pending_stockfish_results" ]]; then
    mkdir -p "$(dirname "$STOCKFISH_NET_LEDGER")"
    printf '%s\n' "$pending_stockfish_results" >> "$STOCKFISH_NET_LEDGER"
    git add -f "$STOCKFISH_NET_LEDGER" || return
    pending_stockfish_results=
  fi
  git ls-files --error-unmatch "$STOCKFISH_NET_LEDGER" >/dev/null 2>&1 \
    && commit_paths+=("$STOCKFISH_NET_LEDGER")

  local commit_rc=0
  git commit --only \
    -m "$subject" \
    -m "Hypothesis:
$hypothesis

Forge command:
$command

Result:
$details" \
    -- "${commit_paths[@]}" || commit_rc=$?
  if (( commit_rc != 0 )); then
    if (( commit_rc == 1 )) && git diff --cached --quiet; then
      : # empty commit — nothing staged
    else
      return $commit_rc
    fi
  fi

  if [[ "$AUTO_ADVANCE" != 1 ]]; then
    echo "committed $BUILD: run=$accepted; automatic advancement disabled"
    return 0
  fi

  if [[ "$result" == PASS ]]; then
    next_base=$accepted
    next=$(next_promoted_run_name "$accepted")
    ln -sfn "$accepted.nn" "$PROMOTED_NET_LINK" || return
  else
    next_base=${continue_from:-}
    next=$(next_run_name "$accepted")
  fi

  local tmp
  tmp=$(mktemp)
  if [[ "$result" == PASS ]]; then
    jq \
      --arg run "$next" \
      --arg continue_from "$next_base" \
      '.run = $run
       | if $continue_from == "" then del(.continue_from) else .continue_from = $continue_from end
       | if ((.data.offset? | type) == "number") and ((.data.limit? | type) == "number") then
           .data.offset = (.data.offset + .data.limit)
         else
           .
         end
       | del(.reference)
       | del(.initialize_from)
       | del(.changed_variables.reference)' \
      "$BUILD" > "$tmp"
  else
    jq \
      --arg run "$next" \
      --arg continue_from "$next_base" \
      '.run = $run
       | if $continue_from == "" then
           .
         else
           .continue_from = $continue_from
           | del(.reference)
           | del(.initialize_from)
           | del(.changed_variables.reference)
         end
       | if ((.data.offset? | type) == "number") and ((.data.limit? | type) == "number") then
           .data.offset = (.data.offset + .data.limit)
         else
           .
         end' \
      "$BUILD" > "$tmp"
  fi
  mv "$tmp" "$BUILD"
  echo "updated $BUILD: run=$next"
}

bump_build_json() {
  commit_and_bump_build_json PASS "$@"
}

fail_build_json() {
  commit_and_bump_build_json FAIL "$@"
}

commit_failed_iteration() {
  fail_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-failed sprt}" \
    || fail "failed build.json commit failed for $run" iterate
  if [[ "$AUTO_ADVANCE" == 1 ]]; then
    record_iteration FAIL "rejected; build.json advanced"
  else
    record_iteration FAIL "rejected; awaiting reconciliation"
  fi
  notify fail iterate "rejected $run: ${last_sprt_line:-sprt failed}" "$summary_file" 1
  print_summary || true
}

record_iteration() {
  local result=$1
  local detail=$2
  {
    echo "$run vs $(reference_label): $result"
    echo "  $detail"
    [[ -n "${last_sprt_line:-}" ]] && echo "  $last_sprt_line"
  } >> "$summary_file"
}

print_summary() {
  [[ -f "${summary_file:-}" ]] || return 0
  section "iteration summary"
  cat "$summary_file"
  echo "summary_file=$summary_file"
}

promoted_net_name() {
  local target
  [[ -L "$PROMOTED_NET_LINK" ]] || return 1
  target=$(readlink "$PROMOTED_NET_LINK") || return 1
  target=${target##*/}
  [[ "$target" == *.nn ]] || return 1
  printf '%s\n' "${target%.nn}"
}

latest_stockfish_result() {
  local candidate=$1
  [[ -s "$STOCKFISH_NET_LEDGER" ]] || return 1
  jq -sc \
    --arg candidate "$candidate" \
    --arg reference "${STOCKFISH_NET##*/}" \
    --argjson games "$STOCKFISH_NET_GAMES" \
    '[.[] | select(
        .candidate == $candidate
        and .reference == $reference
        and .games >= $games
        and (.valid != false)
      )] | last // empty' \
    "$STOCKFISH_NET_LEDGER"
}

run_stockfish_benchmark() {
  local candidate=$1 candidate_path qsprt_tmp result_line elo ci hypothesis
  candidate_path="$HOME/assets/nets/$candidate.nn"
  [[ -f "$candidate_path" ]] \
    || fail "missing Stockfish benchmark candidate: $candidate_path" stockfish_net_sprt
  echo "Stockfish benchmark candidate=$candidate path=$candidate_path"
  hypothesis=$(jq -r '.hypothesis // empty' "$BUILD" 2>/dev/null || printf '')

  # Stream QSPRT output to terminal while capturing the result line.
  # Temporarily disable pipefail so we can check PIPESTATUS[0] manually.
  qsprt_tmp=$(mktemp)
  set +o pipefail
  GAMES="$STOCKFISH_NET_GAMES" STOCKFISH_NET="$STOCKFISH_NET" "$QSPRT" \
    --candidate "$candidate_path" \
    --comment "$candidate.nn vs ${STOCKFISH_NET##*/}: $hypothesis" | tee "$qsprt_tmp"
  local qsprt_rc=${PIPESTATUS[0]}
  set -o pipefail
  result_line=$(grep '^progress=' "$qsprt_tmp" | tail -1 || true)
  rm -f "$qsprt_tmp"
  [[ $qsprt_rc -eq 0 ]] \
    || fail "Stockfish net benchmark failed for $candidate" stockfish_net_sprt

  elo=$(grep -o 'elo=[^ ]*' <<< "$result_line" | cut -d= -f2 | tr -d ',')
  ci=$(grep -o 'ci=[^ ]*' <<< "$result_line" | cut -d= -f2 | tr -d ',')
  [[ -n "$elo" && -n "$ci" ]] \
    || fail "invalid Stockfish benchmark result for $candidate" stockfish_net_sprt

  stockfish_result=$(jq -cn \
    --arg candidate "$candidate" \
    --arg reference "${STOCKFISH_NET##*/}" \
    --argjson games "$STOCKFISH_NET_GAMES" \
    --argjson elo "$elo" \
    --argjson ci "$ci" \
    '{candidate:$candidate, reference:$reference, games:$games, elo:$elo, ci:$ci}')

  if [[ -n "$pending_stockfish_results" ]]; then
    pending_stockfish_results+=$'\n'
  fi
  pending_stockfish_results+=$stockfish_result
}

stockfish_net_gate() {
  local candidate=$1 champion candidate_result champion_result
  local candidate_elo candidate_ci champion_elo champion_ci

  stockfish_delta=
  stockfish_upper90=

  section "Stockfish promotion gate"
  candidate_result=$(latest_stockfish_result "$candidate") || candidate_result=
  if [[ -z "$candidate_result" ]]; then
    run_stockfish_benchmark "$candidate"
    candidate_result=$stockfish_result
  fi

  if ! champion=$(promoted_net_name); then
    last_stockfish_line="Stockfish gate: no existing champion; benchmarked $candidate"
    return 0
  fi

  champion_result=$(latest_stockfish_result "$champion") || champion_result=
  if [[ -z "$champion_result" ]]; then
    run_stockfish_benchmark "$champion"
    champion_result=$stockfish_result
  fi

  candidate_elo=$(jq -r '.elo' <<< "$candidate_result")
  candidate_ci=$(jq -r '.ci' <<< "$candidate_result")
  champion_elo=$(jq -r '.elo' <<< "$champion_result")
  champion_ci=$(jq -r '.ci' <<< "$champion_result")
  # Convert combined 95% CI half-widths to a one-sided 90% upper bound.
  read -r stockfish_delta stockfish_upper90 < <(awk \
    -v candidate="$candidate_elo" -v champion="$champion_elo" \
    -v candidate_ci="$candidate_ci" -v champion_ci="$champion_ci" \
    'BEGIN {
      delta = candidate - champion
      combined_ci = sqrt(candidate_ci * candidate_ci + champion_ci * champion_ci)
      printf "%.1f %.1f\n", delta, delta + 0.654 * combined_ci
    }')

  last_stockfish_line="Stockfish gate: $candidate ${candidate_elo} vs $champion ${champion_elo}; delta=${stockfish_delta}, upper90=${stockfish_upper90}"
  echo "$last_stockfish_line"
  # Veto on the one-sided 90% upper bound, not the point estimate. Both sides
  # are measured at STOCKFISH_NET_GAMES (default 3000), where ci is about 9, so
  # the delta carries roughly +/-13. Testing the raw delta against 0 rejects a
  # genuinely equal candidate half the time. This benchmark resolves gross drift,
  # not small
  # differences, so the gate should only fire when even the optimistic bound
  # says the candidate is worse.
  float_lt "$stockfish_upper90" "$STOCKFISH_NET_MIN_DELTA" && return 1

  local sprt_json
  sprt_json=$(jq -c --arg line "$last_stockfish_line" '
    {
      line: $line,
      elo: (.elo | tostring),
      llr: ("\(.llr)/\(.llr_bound)")
    }' <<< "$candidate_result")
  notify iteration_done stockfish_net_sprt "$last_stockfish_line" "$STOCKFISH_NET_LEDGER" 0 "$sprt_json"
}

stockfish_tie_break() {
  local candidate=$1 parent=$2 candidate_result parent_result
  local candidate_elo parent_elo

  candidate_result=$(latest_stockfish_result "$candidate") || candidate_result=
  # The candidate benchmark immediately preceding this tie-break is pending
  # until the iteration commit. Reuse it rather than launching it again.
  if [[ -z "$candidate_result" && -n "$stockfish_result" ]] \
    && [[ $(jq -r '.candidate // empty' <<<"$stockfish_result") == "$candidate" ]]; then
    candidate_result=$stockfish_result
  fi
  if [[ -z "$candidate_result" ]]; then
    run_stockfish_benchmark "$candidate"
    candidate_result=$stockfish_result
  fi
  parent_result=$(latest_stockfish_result "$parent") || parent_result=
  if [[ -z "$parent_result" ]]; then
    run_stockfish_benchmark "$parent"
    parent_result=$stockfish_result
  fi

  candidate_elo=$(jq -r '.elo' <<< "$candidate_result")
  parent_elo=$(jq -r '.elo' <<< "$parent_result")
  last_stockfish_line="Stockfish tie-break: $candidate ${candidate_elo} vs $parent ${parent_elo}"
  echo "$last_stockfish_line"
  float_lt "$parent_elo" "$candidate_elo"
}

iterate() {
  need jq
  need git
  ensure_git_identity
  if ! mkdir "$NNUE_ITERATE_LOCK_DIR" 2>/dev/null; then
    local lock_pid
    lock_pid=$(cat "$NNUE_ITERATE_LOCK_DIR/pid" 2>/dev/null || true)
    if [[ "$lock_pid" =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
      fail "another NNUE iterate process is active (pid=$lock_pid)" iterate
    fi
    rm -f "$NNUE_ITERATE_LOCK_DIR/pid"
    rmdir "$NNUE_ITERATE_LOCK_DIR" 2>/dev/null || fail "cannot clear stale iterate lock" iterate
    mkdir "$NNUE_ITERATE_LOCK_DIR" || fail "cannot acquire iterate lock" iterate
  fi
  printf '%s\n' "$$" > "$NNUE_ITERATE_LOCK_DIR/pid"
  trap 'rm -f "$NNUE_ITERATE_LOCK_DIR/pid"; rmdir "$NNUE_ITERATE_LOCK_DIR" 2>/dev/null || true' EXIT
  for ((i = 1; i <= ITERATIONS; i++)); do
    load_config
    section "iteration $i"
    show_config
    notify phase_start iterate "starting iteration $i: $run" "$summary_file" 0
    if (( FULL_SPRT_FIRST != 1 || i != 1 )); then
      train || fail "train failed for $run" train
      gates || fail "gates failed for $run" gates
    fi

    if [[ -z "$continue_from" && -z "$initialize_from" && -z "$reference_name" ]]; then
      run_stockfish_benchmark "$run"
      last_sprt_elo=$(jq -r '.elo' <<< "$stockfish_result")
      last_sprt_ci=$(jq -r '.ci' <<< "$stockfish_result")
      last_sprt_llr="fixed-SF baseline"
      last_sprt_command="$QSPRT --candidate $run.nn"
      last_sprt_line="Stockfish baseline: elo=$last_sprt_elo ci=$last_sprt_ci games=$STOCKFISH_NET_GAMES"
      bump_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "$last_sprt_line" \
        || fail "root build.json commit failed for $run" iterate
      record_iteration PASS "scratch root established; fixed-SF baseline recorded"
      notify iteration_done iterate "scratch root $run established: $last_sprt_line" "$summary_file" 1
      break
    fi
    local sprt_rc=0
    if (( FULL_SPRT_FIRST == 1 && i == 1 )); then
      if ! full_sprt_gate; then
        commit_failed_iteration
        break
      fi
    else
      sprt_gate || sprt_rc=$?
      if (( sprt_rc == 1 )); then
        commit_failed_iteration
        break
      fi
    fi
    if (( SKIP_SF_GATE != 1 )); then
      run_stockfish_benchmark "$run"
      if (( sprt_rc == 2 )) && ! stockfish_tie_break "$run" "$continue_from"; then
        last_sprt_line="${last_sprt_line:-parent SPRT inconclusive}; ${last_stockfish_line}"
        commit_failed_iteration
        break
      fi
    fi
    bump_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-passed sprt}" \
      || fail "build.json commit failed for $run" iterate
    if [[ "$AUTO_ADVANCE" == 1 ]]; then
      record_iteration PASS "accepted; build.json advanced"
    else
      record_iteration PASS "accepted; awaiting reconciliation"
    fi
    notify iteration_done iterate "accepted $run: ${last_sprt_line:-sprt passed}" "$summary_file" 1
    [[ "$AUTO_ADVANCE" == 1 ]] || break
  done
  print_summary
}

status() {
  load_config
  show_config
  echo
  pgrep -af '(^|[[:space:]])\.?/nnue([[:space:]]|$)|tools/bullet/train|enyo-bullet-spike|sprt|fastchess' || true
  echo
  find "$log_dir" -maxdepth 1 -type f 2>/dev/null | sort | tail -10
}

help() {
  cat <<'EOF'
Usage:
  ./nnue iterate   # train, gate, SPRT, commit result, stop for reconciliation
  ./nnue iterate --full-sprt-first
  ./nnue plan
  ./nnue train
  ./nnue gates
  ./nnue sprt
  ./nnue sprt --solo
  ./nnue status

Useful overrides:
  AUTO_ADVANCE=1 ./nnue iterate  # legacy: promote symlink and prepare next build
  ITERATIONS=5 ./nnue iterate
  STOCKFISH_NET_GAMES=4000 ./nnue iterate
  ./nnue iterate --full-sprt-first  # first iteration skips train/gates/smoke
  REFERENCE_NET=$HOME/assets/nets/other.nn ./nnue sprt
  SKIP_SMOKE=1 GAMES=800 ./nnue iterate
  SMOKE_GAMES=400 SMOKE_FAIL_ELO=-100 ./nnue sprt
  GAMES=5000 CONCURRENCY=8 THREADS=1 ./nnue sprt

SPRT checkpoints:
  SMOKE_GAMES=500              reject only a catastrophic net (elo <= SMOKE_FAIL_ELO)
  SPRT_ELO1=8                  H1 threshold
  GAMES=4000                   hard cap; policy launch overrides this to 5000
  SKIP_SMOKE=1 ./nnue iterate  # disable smoke; always play GAMES
  FORCE=1 ./nnue train
  MOVE_GATE_STRICT=1 ./nnue gates

Safety:
  automatic build advancement and symlink promotion are disabled by default
  continuation runs must set build.json continue_from
  missing continue_from asks before scratch training in an interactive terminal
  non-interactive missing continue_from fails before training
EOF
}

train_command() {
  train
  notify training_done train "training/export completed for $run" \
    "$log_dir/01-train-export.log" 1
}

# Keep dispatch inside one parsed compound command. A long-running invocation
# may outlive a repository update; Bash must not resume by reading a new tail
# from the script path after Forge returns.
main() {
  case "$cmd" in
    iterate) iterate ;;
    plan) plan ;;
    train) train_command ;;
    gates) gates ;;
    sprt) sprt_command ;;
    status) status ;;
    help|-h|--help) help ;;
    *) fail "unknown command: $cmd" ;;
  esac
}

main "$@"
