#!/usr/bin/env bash
set -Eeuo pipefail

# Thin native NNUE loop:
#   ./nnue iterate   train, gate, SPRT, commit result, stop for reconciliation
#   ./nnue iterate --full-sprt-first  run full SPRT directly for iteration 1 only
#   ./nnue plan      show resolved tools/bullet/train plan
#   ./nnue train     data + train + export
#   ./nnue gates     startpos + static eval + move gate
#   ./nnue sprt      candidate vs reference games
#   ./nnue status    print current run/reference and latest logs

cmd=iterate
SOLO=0
FULL_SPRT_FIRST=0
for arg in "$@"; do
  case "$arg" in
    --solo) SOLO=1 ;;
    --full-sprt-first) FULL_SPRT_FIRST=1 ;;
    iterate|plan|train|gates|sprt|status|help|-h|--help) cmd=$arg ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

BUILD=${BUILD:-build.json}
ARCH=${ARCH:-architecture.json}
DEFAULTS=${DEFAULTS:-defaults.json}
PYTHON=${PYTHON:-.venv/bin/python}
TRAIN_HELPER=${TRAIN_HELPER:-tools/bullet/train}
FORGE=${FORGE:-forge}

ENGINE=${ENGINE:-$HOME/assets/engines/candidate}
REFERENCE_NET=${REFERENCE_NET:-}
CASES=${CASES:-runs/lichess-inacc-miss-blunder-20260612/native760_vs_native123_net_value_bad_move_gate.jsonl}

ROWS=${ROWS:-50000}
# A parent promotion uses the fixed game cap and Forge's final LLR bound.
# Optional smoke triage may stop only a catastrophically bad candidate.
SMOKE_GAMES=${SMOKE_GAMES:-500}                    # checkpoint 1: stop if catastrophically bad
SMOKE_FAIL_ELO=${SMOKE_FAIL_ELO:--100.0}
GAMES=${GAMES:-4000}                               # final game budget (ci ~= 10 at this size)
PROMOTION_GAMES=${PROMOTION_GAMES:-5000}           # required direct parent match
SKIP_SMOKE=${SKIP_SMOKE:-0}                        # 1 disables every checkpoint
SPRT_POLL_SECONDS=${SPRT_POLL_SECONDS:-30}   # how often to re-read Forge status mid-run
# Hard bound on the poll loop so a silently dead Forge run cannot hang the
# iteration forever. 0 disables the bound.
SPRT_MAX_WAIT_SECONDS=${SPRT_MAX_WAIT_SECONDS:-86400}
CONCURRENCY=${CONCURRENCY:-8}
THREADS=${THREADS:-1}
ITERATIONS=${ITERATIONS:-999}
AUTO_ADVANCE=${AUTO_ADVANCE:-0}                    # 1 restores legacy build bump + symlink promotion
STOCKFISH_NET=${STOCKFISH_NET:-nn-0ee0657fb25e.nnue}
STOCKFISH_NET_GAMES=${STOCKFISH_NET_GAMES:-4000}
STOCKFISH_NET_LEDGER=${STOCKFISH_NET_LEDGER:-benchmarks/stockfish-net.jsonl}
STOCKFISH_NET_MIN_DELTA=${STOCKFISH_NET_MIN_DELTA:-0}
SKIP_SF_GATE=${SKIP_SF_GATE:-0}
SKIP_RESIDUAL_GATE=${SKIP_RESIDUAL_GATE:-0}
QSPRT=${QSPRT:-tools/validate/sprt_net.py}
PROMOTED_NET_LINK=${PROMOTED_NET_LINK:-$HOME/assets/nets/candidate.net}
SPRT_ELO0=${SPRT_ELO0:-0.0}
# H1 is deliberately wide so Forge can reject clear losses promptly.
SPRT_ELO1=${SPRT_ELO1:-8.0}
SPRT_ALPHA=${SPRT_ALPHA:-0.10}
SPRT_BETA=${SPRT_BETA:-0.10}

# Loose broken-net gates. These stop obviously bad exports/training before SPRT.
# They are not promotion criteria; SPRT decides whether an iteration is accepted.
MAX_STARTPOS_CP=${MAX_STARTPOS_CP:-300}    # Startpos outside +/-300cp usually means scale/sign/export trouble.
MAX_MAE=${MAX_MAE:-600}                    # Sane native runs are around 300cp on 50k rows; 600+ is suspect.
MIN_SIGN=${MIN_SIGN:-55}                   # 50% is chance; below 55% barely knows which side is better.
MIN_CORR=${MIN_CORR:-0.20}                 # Near zero means eval is mostly unrelated to target.
MAX_ABS_BIAS=${MAX_ABS_BIAS:-300}          # Hundreds of cp offset indicates global bias/scale/sign trouble.
MIN_SLOPE=${MIN_SLOPE:-0.10}               # Near zero means dead/flat eval.
MIN_MATERIAL_CORR=${MIN_MATERIAL_CORR:-0.20}
MIN_MATERIAL_SLOPE=${MIN_MATERIAL_SLOPE:-0.05}
MOVE_GATE_STRICT=${MOVE_GATE_STRICT:-0}    # 0 reports move gate; 1 also fails on worse selected-move counts.
REQUIRE_RESIDUAL_GATE=${REQUIRE_RESIDUAL_GATE:-0}  # 1 makes residual improvement promotional
RESIDUAL_FEN_FILE=${RESIDUAL_FEN_FILE:-runs/structural-audit-50k-balanced.fens}
RESIDUAL_ROWS=${RESIDUAL_ROWS:-50000}

EVENT_HOOK=${EVENT_HOOK:-tools/events/nnue_event_ntfy.sh}
NNUE_NTFY=${NNUE_NTFY:-1}
NNUE_AI_STDIN_EVENTS=${NNUE_AI_STDIN_EVENTS:-done,fail}
export NNUE_AI_STDIN_EVENTS
NNUE_ITERATE_LOCK_DIR=${NNUE_ITERATE_LOCK_DIR:-runs/.nnue-iterate.lock}

run=
continue_from=
initialize_from=
reference_name=
run_dir=
log_dir=
candidate_net=
data_file=
reference_net=
residual_ref_net=
train_build=
scratch_confirmed=0
summary_file=
last_sprt_elo=
last_sprt_llr=
last_sprt_ci=
last_sprt_los=
last_sprt_line=
last_sprt_command=
last_sprt_log=
last_stockfish_line=
stockfish_result=
stockfish_delta=
stockfish_upper90=
pending_stockfish_results=

fail() {
  echo "FAILED: $*" >&2
  notify fail "${2:-n/a}" "$*" "" 1
  print_summary || true
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

json() {
  jq -r "$1" "$BUILD"
}

abs_path() {
  case "$1" in
    "~"/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

net_for_name_or_path() {
  [[ -z "$1" || "$1" == "null" ]] && return 1
  case "$1" in
    "~"/*|/*|*.nn|*.net) abs_path "$1" ;;
    *) echo "$HOME/assets/nets/$1.nn" ;;
  esac
}

load_config() {
  [[ $(jq -r 'has("init_net")' "$BUILD") != true ]] \
    || fail "build.json init_net was renamed to initialize_from" config
  run=$(json '.run')
  continue_from=$(json '.continue_from // empty')
  residual_ref_net=$(net_for_name_or_path "$continue_from") || residual_ref_net=
  initialize_from=$(json '.initialize_from // empty')
  reference_name=$(json '.reference // empty')
  run_dir="runs/$run"
  log_dir="$run_dir/logs"
  candidate_net="$HOME/assets/nets/$run.nn"
  data_file=$(abs_path "$(jq -r --arg run "$run" '
    .data.bullet_output
    // (if (((.data.source_binpack // "") | endswith(".bullet"))
            and ((.data.offset // 0) == 0)
            and ((.data.limit // 0) == 0))
        then .data.source_binpack
        else ("data/bullet/" + $run + ".bullet")
        end)
  ' "$BUILD")")
  mkdir -p "$log_dir" runs/logs
  local ref_source="${REFERENCE_NET:-${reference_name:-$continue_from}}"
  if [[ -n "$ref_source" ]]; then
    reference_net=$(net_for_name_or_path "$ref_source")
  else
    reference_net=
  fi
  summary_file=${summary_file:-runs/logs/nnue-iterate-$(date +%Y%m%d_%H%M%S).txt}
  if [[ $(json '.skip_stockfish_gate // false') == "true" ]]; then
    SKIP_SF_GATE=1
  fi
  if [[ $(json '.skip_residual_gate // false') == "true" ]]; then
    SKIP_RESIDUAL_GATE=1
  fi
}

reference_label() {
  printf '%s\n' "${REFERENCE_NET:-${reference_name:-$continue_from}}"
}

require_training_origin() {
  local stage=${1:-train}
  [[ -n "$continue_from" || -n "$initialize_from" ]] && return 0
  return 0
}

training_build() {
  require_training_origin train
  train_build="$run_dir/build.resolved.json"
  jq --arg prev "$continue_from" \
    'if $prev == "" then del(.continue_from) else .continue_from = $prev end
     | del(.reference)
     | del(.changed_variables.reference)' \
    "$BUILD" > "$train_build"
  printf '%s\n' "$train_build"
}

notify() {
  local event=$1 phase=$2 message=$3 log=${4:-} user_notify=${5:-0} sprt_json=${6:-null}
  [[ "$NNUE_NTFY" == 1 ]] || return 0
  [[ -x "$EVENT_HOOK" ]] || return 0
  local payload
  payload=$(jq -cn \
    --arg event "$event" \
    --arg run "${run_dir:-runs/${run:-unknown}}" \
    --arg stage "$phase" \
    --arg status "$event" \
    --arg message "$message" \
    --arg log "$log" \
    --arg summary "${summary_file:-}" \
    --argjson user_notify "$user_notify" \
    --argjson sprt "$sprt_json" \
    '{
      event:$event,
      run:$run,
      stage:$stage,
      status:$status,
      message:$message,
      log:$log,
      summary:$summary,
      user_notify:$user_notify,
      critical_failure:($event == "fail"),
      good_news:($event == "iteration_done" and $user_notify)
    }
    | if $sprt == null then . else .sprt = $sprt end')
  NNUE_RUN_EVENT_JSON=$payload NNUE_HOOK_EVENTS="${HOOK_EVENTS:-$NNUE_AI_STDIN_EVENTS}" "$EVENT_HOOK" >/dev/null 2>&1 || true
}

notify_sprt() {
  local event=$1 phase=$2 message=$3 log=${4:-} user_notify=${5:-0}
  local sprt_json
  sprt_json=$(jq -cn \
    --arg line "${last_sprt_line:-}" \
    --arg elo "${last_sprt_elo:-}" \
    --arg llr "${last_sprt_llr:-}" \
    '{line:$line, elo:$elo, llr:$llr}')
  notify "$event" "$phase" "$message" "$log" "$user_notify" "$sprt_json"
}

section() {
  printf '\n\n  \033[1m▶ %s\033[0m\n' "$1"
  printf '  ────────────────────────────────────────\n'
}

result_pass() {
  printf '  │ %-8s %10s  %s %s\n' "$1" "$2" "$3" "$4"
}

show_config() {
  load_config
  cat <<EOF
run=$run
continue_from=${continue_from:-}
reference=$(reference_label)
engine=$ENGINE
reference_net=$reference_net
candidate_net=$candidate_net
data=$data_file
logs=$log_dir
EOF
}

float_ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }
float_le() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a <= b) }'; }
float_lt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }'; }
abs_float_le() { awk -v a="$1" -v b="$2" 'BEGIN { if (a < 0) a = -a; exit !(a <= b) }'; }

sprt_h1_passed() {
  local value upper
  value=$(sed -nE 's/^[[:space:]]*([+-]?[0-9]+([.][0-9]+)?)\/.*/\1/p' <<< "$1")
  upper=$(sed -nE 's/^[[:space:]]*[+-]?[0-9]+([.][0-9]+)?\/([+-]?[0-9]+([.][0-9]+)?).*/\2/p' <<< "$1")
  [[ -n "$value" && -n "$upper" ]] || return 2
  float_ge "$value" "$upper"
}

smoke_sprt_failed() {
  local elo=$1
  if float_le "$elo" "$SMOKE_FAIL_ELO"; then
    return 0
  fi
  return 1
}

full_sprt_label=
full_sprt_pass() {
  if sprt_h1_passed "$last_sprt_llr"; then
    full_sprt_label="H1 reached"
    return 0
  fi
  return 1
}

quote_cmd() {
  printf '%q ' "$@"
  printf '\n'
}

ensure_train_helper_current() {
  [[ -x "$TRAIN_HELPER" ]] || fail "missing trainer helper: $TRAIN_HELPER" train
  [[ "${ALLOW_STALE_TRAIN_HELPER:-0}" == 1 ]] && return 0

  local helper
  helper=$(abs_path "$TRAIN_HELPER")
  local source
  for source in \
    tools/bullet/spike_trainer/Cargo.toml \
    tools/bullet/spike_trainer/src/bin/train.rs \
    tools/bullet/spike_trainer/src/main.rs
  do
    [[ -e "$source" ]] || continue
    if [[ "$source" -nt "$helper" ]]; then
      fail "stale trainer helper: $TRAIN_HELPER is older than $source; rebuild it on the CUDA host" train
    fi
  done
}

ensure_git_identity() {
  git config user.name "Petter Wahlman"
  git config user.email "petter@wahlman.no"
}

metric() {
  awk -F= -v key="$1" '$1 == key { gsub(/%/, "", $2); print $2 }' "$2" | tail -1
}

plan() {
  load_config
  require_training_origin plan
  ensure_train_helper_current
  local build_for_train
  build_for_train=$(training_build)
  "$TRAIN_HELPER" plan --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS"
}

train() {
  load_config
  require_training_origin train
  local build_for_train
  build_for_train=$(training_build)
  local log="$log_dir/01-train-export.log"
  local plan_log="$log_dir/00-plan.log"

  notify phase_start train "training $run" "$log" 0
  ensure_train_helper_current
  section plan
  "$TRAIN_HELPER" plan --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS" | tee "$plan_log" || fail "plan failed for $run" plan
  local train_args=(all --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS")
  if [[ "${FORCE:-0}" == 1 ]]; then
    train_args+=(--force)
  fi
  section train
  "$TRAIN_HELPER" "${train_args[@]}" \
    2>&1 | tee "$log" \
    || fail "train/export failed for $run" train
  notify phase_done train "training/export passed for $run" "$log" 0
}

require_distinct_nets() {
  local candidate=$1
  local reference=$2
  [[ -f "$candidate" ]] || fail "missing candidate net: $candidate" distinct_net
  [[ -f "$reference" ]] || fail "missing reference net: $reference" distinct_net
  cmp -s "$candidate" "$reference" \
    && fail "candidate net is byte-identical to reference: $candidate == $reference" distinct_net
  return 0
}

gate_passed()      { [[ -f "${log_dir}/.passed_${1}" ]]; }
mark_gate_passed() { touch "${log_dir}/.passed_${1}"; }
skip_gate() {
  section "$1"
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;33m↩ SKIP\033[0m  %s (already passed)\n' "$1"
  printf '  └─────────────────────────────────────\n'
}

distinct_net_gate() {
  load_config
  gate_passed distinct_net && { skip_gate distinct_net; return 0; }
  notify phase_start distinct_net "distinct net gate $run" "$log_dir/02-distinct-net.log" 0
  section distinct_net
  if [[ -z "$reference_net" ]]; then
    [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" distinct_net
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ N/A\033[0m  distinct_net (scratch root has no reference)\n'
    printf '  └─────────────────────────────────────\n'
    mark_gate_passed distinct_net
    notify phase_done distinct_net "distinct_net not applicable for scratch root $run" "$log_dir/02-distinct-net.log" 0
    return 0
  fi
  require_distinct_nets "$candidate_net" "$reference_net"
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  distinct_net\n'
  printf '  └─────────────────────────────────────\n'
  mark_gate_passed distinct_net
  notify phase_done distinct_net "distinct net gate passed for $run" "$log_dir/02-distinct-net.log" 0
}

startpos_gate() {
  load_config
  gate_passed startpos && { skip_gate startpos; return 0; }
  notify phase_start startpos "startpos gate $run" "$log_dir/02-startpos.log" 0
  section startpos
  show_config
  [[ -x "$ENGINE" ]] || fail "missing engine: $ENGINE" startpos
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" startpos

  local log="$log_dir/02-startpos.log"
  printf 'uci\nsetoption name nnue_file value %s\nisready\nposition startpos\ngo depth 3\nquit\n' "$candidate_net" \
    | "$ENGINE" | tee "$log"

  grep -Eq 'evaluator=(enyo|native)-nnue' "$log" || fail "engine did not load Enyo NNUE" startpos

  local hidden buckets channels cp
  hidden=$(jq -r .hidden "$ARCH")
  buckets=$(jq -r '.runtime_input_buckets // .input_buckets' "$ARCH")
  channels=$(jq -r .feature_channels "$ARCH")
  grep -q "hidden=$hidden" "$log" || fail "hidden mismatch, expected $hidden" startpos
  grep -q "input_buckets=$buckets" "$log" || fail "input_buckets mismatch, expected $buckets" startpos
  grep -q "feature_channels=$channels" "$log" || fail "feature_channels mismatch, expected $channels" startpos

  cp=$(awk '/info depth 3 / { for (i = 1; i <= NF; i++) if ($i == "cp") print $(i + 1) }' "$log" | tail -1)
  [[ -n "$cp" ]] || fail "startpos depth 3 had no cp score" startpos
  abs_float_le "$cp" "$MAX_STARTPOS_CP" || fail "startpos cp $cp outside +/-$MAX_STARTPOS_CP" startpos
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  startpos\n'
  result_pass "cp" "$cp" "|cp| <" "$MAX_STARTPOS_CP"
  printf '  └─────────────────────────────────────\n'
  mark_gate_passed startpos
  notify phase_done startpos "startpos passed for $run: cp=$cp" "$log" 0
}

static_gate() {
  load_config
  gate_passed static_eval && { skip_gate static_eval; return 0; }
  notify phase_start static_eval "static eval gate $run" "$log_dir/03-static-eval.log" 0
  section static_eval
  local log="$log_dir/03-static-eval.log"
  local mae sign corr bias slope
  local full_heads mode
  full_heads=$(jq -r '.output_bucket_scope == "full-head"' "$ARCH")
  mode=$(jq -r '.mode // "enyo"' "$ARCH")
  if gate_passed static_metrics; then
    mae=$(metric mae "$log"); sign=$(metric sign "$log"); corr=$(metric corr "$log")
    bias=$(metric bias "$log"); slope=$(metric slope "$log")
    printf '  │ \033[1;33m↩ SKIP\033[0m  static_metrics (already passed)\n'
  else
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" static_eval
  [[ -f "$data_file" ]] || fail "missing data: $data_file" static_eval
  local eval_args=(
    --net "$candidate_net" --data "$data_file" --rows "$ROWS"
    --batch-size 4096 --device cpu --buckets
  )
  if [[ "$mode" == reckless ]]; then
    local engine_static_jsonl
    engine_static_jsonl=${ENGINE_STATIC_JSONL:-$HOME/assets/enyo_nnue_data/sf_labels/sf_combined_904k.val.jsonl}
    [[ -f "$engine_static_jsonl" ]] \
      || fail "missing engine static JSONL: $engine_static_jsonl" static_eval
    "$PYTHON" tools/validate/eval_jsonl_engine.py \
      --engine "$ENGINE" --net "$candidate_net" --jsonl "$engine_static_jsonl" \
      --rows "$ROWS" --threads 1 --hash 64 --buckets \
      --material-buckets reckless 2>&1 | tee "$log"
  else
    [[ "$full_heads" == true ]] && eval_args+=(--material-buckets)
    "$PYTHON" tools/validate/eval_dataset.py \
      "${eval_args[@]}" 2>&1 | tee "$log"
  fi
  mae=$(metric mae "$log")
  sign=$(metric sign "$log")
  corr=$(metric corr "$log")
  bias=$(metric bias "$log")
  slope=$(metric slope "$log")
  [[ -n "$mae" && -n "$sign" && -n "$corr" && -n "$bias" && -n "$slope" ]] || fail "missing static eval metric" static_eval
  float_le "$mae" "$MAX_MAE" || fail "MAE $mae > $MAX_MAE" static_eval
  float_ge "$sign" "$MIN_SIGN" || fail "sign $sign < $MIN_SIGN" static_eval
  float_ge "$corr" "$MIN_CORR" || fail "corr $corr < $MIN_CORR" static_eval
  abs_float_le "$bias" "$MAX_ABS_BIAS" || fail "bias $bias outside +/-$MAX_ABS_BIAS" static_eval
  float_ge "$slope" "$MIN_SLOPE" || fail "slope $slope < $MIN_SLOPE" static_eval
  mark_gate_passed static_metrics
  fi  # end static_metrics block

  if [[ "${SKIP_RESIDUAL_GATE}" != 1 && -n "$continue_from" ]]; then
    local residual_log="$log_dir/03-residual-audit.log"
    local residual_json="$log_dir/03-residual-audit.json"
    [[ -f "$RESIDUAL_FEN_FILE" ]] \
      || fail "missing residual audit positions: $RESIDUAL_FEN_FILE" residual_gate
    if gate_passed residual_gate; then
      printf '  │ \033[1;33m↩ SKIP\033[0m  residual_gate (already passed)\n'
    else
    notify phase_start residual_gate "50k residual audit for $run" "$residual_log" 0
    if [[ -f "$residual_json" && "$residual_json" -nt "$candidate_net" ]]; then
      printf '  │ \033[1;33m↩ REUSE\033[0m  residual audit (nets unchanged)\n'
    else
      "$PYTHON" tools/validate/structural_net_audit.py \
        --engine "$ENGINE" \
        --subject "reference=$residual_ref_net" \
        --subject "candidate=$candidate_net" \
        --subject "stockfish=$HOME/assets/nets/$STOCKFISH_NET" \
        --fen-file "$RESIDUAL_FEN_FILE" \
        --limit "$RESIDUAL_ROWS" \
        --threads 1 \
        --hash 64 \
        --json-out "$residual_json" 2>&1 | tee "$residual_log"
    fi
    local residual_rc=0
    "$PYTHON" tools/validate/residual_gate.py \
      --audit "$residual_json" 2>&1 | tee -a "$residual_log" || residual_rc=$?
    if (( residual_rc == 0 )); then
      mark_gate_passed residual_gate
      notify phase_done residual_gate "residual audit passed for $run" "$residual_log" 0
    elif [[ "$REQUIRE_RESIDUAL_GATE" == 1 ]]; then
      fail "candidate did not improve required endgame/high-eval residuals" residual_gate
    else
      printf '  │ \033[1;33m⚠ REPORT\033[0m  residual audit did not improve; SPRT decides promotion\n'
      notify phase_done residual_gate "residual audit reported no improvement for $run; SPRT decides promotion" "$residual_log" 0
    fi
    fi  # end residual_gate block
  fi

  if [[ "$full_heads" == true ]]; then
    local init_weights trained_weights trainable
    if [[ "$mode" == reckless ]]; then
      init_weights="runs/$run/checkpoints/$(jq -r --slurpfile defaults "$DEFAULTS" \
        '.net_id // $defaults[0].net_id' "$BUILD")-seeded-init.bin"
    else
      init_weights="runs/$run/init/optimiser_state/weights.bin"
    fi
    trained_weights=$(find "runs/$run/checkpoints" -path '*/optimiser_state/weights.bin' \
      -printf '%p\n' 2>/dev/null | sort -V | tail -1)
    trainable=$(jq -r --slurpfile defaults "$DEFAULTS" \
      '.trainable // $defaults[0].trainable' "$BUILD")
    [[ -f "$init_weights" ]] || fail "missing full-head initialization weights" static_eval
    [[ -f "$trained_weights" ]] || fail "missing trained full-head weights" static_eval
    local update_args=(
      --initial "$init_weights" --trained "$trained_weights"
      --output-buckets "$(jq -r .output_buckets "$ARCH")"
    )
    [[ "$trainable" == dense-head ]] && update_args+=(--expect-frozen-input)
    "$PYTHON" tools/validate/check_full_head_updates.py "${update_args[@]}" \
      2>&1 | tee -a "$log" \
      || fail "full-head dense paths did not all update" static_eval

    local output_buckets bucket material_rows material_corr material_slope
    output_buckets=$(jq -r .output_buckets "$ARCH")
    for ((bucket = 0; bucket < output_buckets; bucket++)); do
      material_rows=$(metric "material_bucket_${bucket}_rows" "$log")
      material_corr=$(metric "material_bucket_${bucket}_corr" "$log")
      material_slope=$(metric "material_bucket_${bucket}_slope" "$log")
      [[ -n "$material_rows" && "$material_rows" -gt 0 ]] \
        || fail "material bucket $bucket has no validation rows" static_eval
      float_ge "$material_corr" "$MIN_MATERIAL_CORR" \
        || fail "material bucket $bucket corr $material_corr < $MIN_MATERIAL_CORR" static_eval
      float_ge "$material_slope" "$MIN_MATERIAL_SLOPE" \
        || fail "material bucket $bucket slope $material_slope < $MIN_MATERIAL_SLOPE" static_eval
    done
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  static_eval\n'
  result_pass "mae" "$mae" "<" "$MAX_MAE"
  result_pass "sign" "$sign" ">" "$MIN_SIGN"
  result_pass "corr" "$corr" ">" "$MIN_CORR"
  result_pass "bias" "$bias" "|b| <" "$MAX_ABS_BIAS"
  result_pass "slope" "$slope" ">" "$MIN_SLOPE"
  printf '  └─────────────────────────────────────\n'
  mark_gate_passed static_eval
  notify phase_done static_eval "static_eval passed for $run: mae=$mae sign=$sign corr=$corr bias=$bias slope=$slope" "$log" 0
}

move_gate() {
  load_config
  gate_passed move_gate && { skip_gate move_gate; return 0; }
  notify phase_start move_gate "move gate $run" "$log_dir/04-move-gate.log" 0
  section move_gate
  if [[ -z "$reference_net" ]]; then
    [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" move_gate
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ N/A\033[0m  move_gate (scratch root has no reference)\n'
    printf '  └─────────────────────────────────────\n'
    mark_gate_passed move_gate
    notify phase_done move_gate "move_gate not applicable for scratch root $run" "$log_dir/04-move-gate.log" 0
    return 0
  fi
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" move_gate
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" move_gate
  if [[ ! -f "$CASES" ]]; then
    [[ "$MOVE_GATE_STRICT" == 1 ]] && fail "missing move gate cases: $CASES" move_gate
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;33m→ SKIP\033[0m  move_gate\n'
    result_pass "cases" "missing" "strict" "$MOVE_GATE_STRICT"
    printf '  └─────────────────────────────────────\n'
    mark_gate_passed move_gate
    notify phase_done move_gate "move_gate skipped for $run: missing cases $CASES" "$log_dir/04-move-gate.log" 0
    return 0
  fi
  local log="$log_dir/04-move-gate.log"
  local summary="$run_dir/move_gate.summary.json"
  "$PYTHON" tools/validate/eval_move_gate.py \
    --cases "$CASES" --engine "$ENGINE" --reference-net "$reference_net" \
    --candidate-net "$candidate_net" --threads 1 --hash 64 \
    --summary-json "$summary" --output "$run_dir/move_gate.jsonl" 2>&1 | tee "$log"
  local ref cand fixed regressed
  ref=$(jq -r .baseline_prefers_best "$summary")
  cand=$(jq -r .candidate_prefers_best "$summary")
  fixed=$(jq -r .fixed "$summary")
  regressed=$(jq -r .regressed "$summary")
  echo "move_gate reference_prefers_best=$ref candidate_prefers_best=$cand fixed=$fixed regressed=$regressed"
  if [[ "$MOVE_GATE_STRICT" == 1 ]]; then
    (( cand >= ref )) || fail "move gate candidate_prefers_best $cand < reference $ref" move_gate
    (( fixed > regressed )) || fail "move gate fixed $fixed <= regressed $regressed" move_gate
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  move_gate\n'
  result_pass "candidate" "$cand" "reference" "$ref"
  result_pass "fixed" "$fixed" "regressed" "$regressed"
  printf '  └─────────────────────────────────────\n'
  mark_gate_passed move_gate
  notify phase_done move_gate "move_gate passed for $run: candidate=$cand reference=$ref fixed=$fixed regressed=$regressed" "$log" 0
}

