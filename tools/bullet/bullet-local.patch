         ansi(minutes, num_cs),
         ansi(seconds, num_cs),
+        ansi(completion, num_cs),
     );
 }
 
+fn completion_time(seconds: u32) -> String {
+    let timestamp = SystemTime::now()
+        .checked_add(Duration::from_secs(u64::from(seconds)))
+        .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+        .map_or(0, |duration| duration.as_secs() as libc::time_t);
+    let mut local = MaybeUninit::<libc::tm>::uninit();
+    let local = unsafe {
+        if libc::localtime_r(&timestamp, local.as_mut_ptr()).is_null() {
+            return "--:--:--".to_owned();
+        }
+        local.assume_init()
+    };
+
+    format!("{:02}:{:02}:{:02}", local.tm_hour, local.tm_min, local.tm_sec)
+}
