-
-                if !ir.is_output(input) && !ir.is_input(input)? {
-                    // no topo check as performs y = copy(x) -> y = copy(y)
-                    ir.ir_mut().replace_input_no_cycle_check(output, input)?;
-                    ir.swap_outputs(input, output)?;
-                    ir.remove_op(op.id())?;
-                }
+                // When output IS a registered backward output, keep the CopyOp alive.
+                // Case 2 (swap_outputs to promote the input to registered) is intentionally
+                // omitted: it changes which NodeId holds the gradient registration, breaking
+                // the bwd_map NodeId tracking in builder.rs. The GPU backend's CopyOp
+                // codegen in generate.rs handles these surviving CopyOps correctly.
             }
         }
 
@@ -64,17 +62,30 @@ fn eliminate_single_common_subexpr(ir: &mut TensorIR) -> Result<bool, IRTrace> {
     for (i, op_i) in ops.iter().enumerate() {
         for op_j in ops.iter().skip(i + 1) {
             if op_i.inputs() == op_j.inputs() && op_i.data().0.equals(op_j.data()) {
-                for (&out_i, &out_j) in op_i.outputs().iter().zip(op_j.outputs()) {
-                    ir.replace_input(out_i, out_j)?;
-
-                    if ir.is_output(out_j) {
-                        let new_out = ir.copy(out_i)?;
-                        ir.swap_outputs(new_out, out_j)?;
+                let any_j_registered = op_j.outputs().iter().any(|&o| ir.is_output(o));
+                let any_i_registered = op_i.outputs().iter().any(|&o| ir.is_output(o));
+
+                if any_j_registered && !any_i_registered {
+                    // op_j has registered outputs; keep op_j, discard op_i.
+                    // This avoids inserting a CopyOp for op_j's registered output NodeIds,
+                    // which the GPU codegen cannot materialise as a standalone output pointer.
+                    for (&out_i, &out_j) in op_i.outputs().iter().zip(op_j.outputs()) {
+                        ir.replace_input(out_j, out_i)?;
+                    }
+                    ir.remove_op(op_i.id())?;
+                } else {
+                    // Default: keep op_i (first-seen), discard op_j.
+                    for (&out_i, &out_j) in op_i.outputs().iter().zip(op_j.outputs()) {
+                        ir.replace_input(out_i, out_j)?;
+
+                        if ir.is_output(out_j) {
+                            let new_out = ir.copy(out_i)?;
+                            ir.swap_outputs(new_out, out_j)?;
+                        }
                     }
+                    ir.remove_op(op_j.id())?;
                 }
 
-                ir.remove_op(op_j.id())?;
-
                 return Ok(true);
             }
         }
