         ScalarConstant, Select, SelectPad, SliceAcrossDimension, SparseMatmul, SparseMatmulBwdMulti, SubGraph, Unary,
         UnaryOp,
     },
@@ -97,6 +97,9 @@ pub fn generate(sub: &SubGraph, props: &DeviceProps) -> Result<Option<(Pointwise
             } else {
                 return Ok(None);
             }
+        } else if let Some(copy) = data.downcast::<CopyOp>() {
+            let size = copy.0.size();
+            (size, size.factor())
         } else {
             return Ok(None);
         };
@@ -318,6 +321,10 @@ pub fn generate(sub: &SubGraph, props: &DeviceProps) -> Result<Option<(Pointwise
 
             let output = pntwise.conditional_read(values, idx, cond, DValue::zero(select_pad.dtype), p2size)?;
             mapping.insert(op.outputs()[0], output);
+        } else if data.downcast::<CopyOp>().is_some() {
+            let out = op.outputs()[0];
+            let Some(input) = get_val(op.inputs()[0], &mut pntwise, &mapping)? else { return Ok(None) };
+            mapping.insert(out, input);
         } else if let Some(reduce) = data.downcast::<ReduceAcrossDimension>() {
             let out = op.outputs()[0];
             let Some(value) = get_val(op.inputs()[0], &mut pntwise, &mapping)? else { return Ok(None) };
diff --git a/crates/gpu/src/pointwise/transforms.rs b/crates/gpu/src/pointwise/transforms.rs
index d4c2b98..0b567f3 100644
--- a/crates/gpu/src/pointwise/transforms.rs
+++ b/crates/gpu/src/pointwise/transforms.rs
@@ -190,7 +190,7 @@ fn fuse_subgraphs(ir: &TensorIR, op_i: OpId, op_j: OpId) -> Result<(SubGraph, Ve
     for (&out, &new_out) in op_i.outputs().iter().zip(outputs_i.iter()) {
         map.insert(out, new_out);
 
-        if !op_j_set.contains(&out) || ir.get_node(out)?.children() > 1 {
+        if !op_j_set.contains(&out) || ir.get_node(out)?.children() > 1 || ir.is_output(out) {
             total_outputs.push(out);
             new_sub.register_output(new_out);
         }
diff --git a/crates/gpu/src/runtime.rs b/crates/gpu/src/runtime.rs
index f439898..c6f116f 100644
--- a/crates/gpu/src/runtime.rs
+++ b/crates/gpu/src/runtime.rs
@@ -296,7 +296,14 @@ impl<G: Gpu> Module<G> {
         let opt_ptr_ptr = if options_ptrs.is_empty() { std::ptr::null() } else { options_ptrs.as_ptr() };
 
         let src = CString::new(source_code.into()).map_err(|e| format!("{e:?}"))?;
-        let code = unsafe { G::program_compile(&src, options_ptrs.len() as i32, opt_ptr_ptr)? };
+        let code = match unsafe { G::program_compile(&src, options_ptrs.len() as i32, opt_ptr_ptr) } {
+            Err(e) if !options.is_empty() && format!("{e:?}").contains("INVALID_OPTION") => {
+                // NVRTC doesn't support this arch (e.g. sm_120 on CUDA 12.4).
+                // Fall back to generic PTX; the CUDA driver JIT-compiles it to native arch.
+                unsafe { G::program_compile(&src, 0, std::ptr::null()) }?
+            }
+            other => other?,
+        };
         let module = unsafe { G::module_create(code.as_ptr().cast())? };
 
         Ok(Arc::new(Self { device, module }))
