{
  "schema": "forge.template.v1",
  "name": "sample-lc0-calibration",
  "kind": "label",
  "description": "Distributed deterministic LC0-root/static-Enyo pair sampling for calibration fitting",
  "run_name": "sample-lc0-calibration-{input_stem}-{timestamp}",
  "work_dir": "{labeler}",
  "materialize_inputs": true,
  "path_maps": {"macos": {"~/.cache/forge": "~/Library/Caches/forge"}},
  "chunking": {"initial_units": 5000, "min_chunks_per_slot": 0, "signature_version": "task-input-v1"},
  "parameters": {
    "chunk_time_seconds": {"type": "int", "default": 300, "help": "Target wall-clock seconds per adaptive chunk"},
    "labeler": {"type": "source", "default": "nnue", "include": ["tools/score/**", "tools/lib/**", "tools/posgen/**", "tools/tests/test_streaming_labeling.py", "tools/tests/test_lc0_to_jsonl.py", "tools/tests/test_lc0_calibration.py"], "exclude": ["**/__pycache__/**", "**/.venv/**", "**/target/**"], "output": "~/.cache/forge/sources/nnue-{digest12}", "help": "Committed NNUE labeler source"},
    "input": {"required": true, "path_context": "shared_home", "help": "LC0 training.* directory"},
    "engine": {"required": true, "local_default": true, "path_context": "shared_home", "help": "Static Enyo engine executable"},
    "net": {"required": true, "local_default": true, "path_context": "shared_home", "help": "Fixed Enyo/Stockfish reference net defining target coordinates"},
    "threads": {"type": "int", "default": 1, "help": "Engine threads per shard"},
    "hash": {"type": "int", "default": 64, "help": "Engine hash MiB per shard"},
    "max_records": {"type": "int", "default": 0, "help": "Global raw record limit; zero means all"},
    "split_records": {"type": "int", "default": 1600, "help": "Positive planner placeholder when max_records is zero"},
    "min_ply": {"type": "int", "default": 16, "help": "Minimum game ply"},
    "quiet_only": {"type": "bool", "default": true, "help": "Keep quiet non-check positions"},
    "sample_modulus": {"type": "int", "default": 10000, "help": "Keep records whose deterministic hash modulo this value is zero"},
    "shards": {"type": "int", "help": "Override adaptive task count"}
  },
  "requirements": {
    "python_min": "3.11",
    "sources": [{"name": "nnue-calibration", "path": "{labeler}", "digest": "{labeler_digest}", "install_timeout_s": 300, "install": ["PYTHON=python3; test ! -x /opt/homebrew/bin/python3 || PYTHON=/opt/homebrew/bin/python3; test -x .venv/bin/python || \"$PYTHON\" -m venv .venv; .venv/bin/python -m pip install -q python-chess"], "probe": [".venv/bin/python -m unittest tools.tests.test_streaming_labeling tools.tests.test_lc0_to_jsonl tools.tests.test_lc0_calibration"]}],
    "commands": [{"name": "engine", "path": "{engine}", "command": "test -x {engine} 2>/dev/null || command -v {engine} >/dev/null", "timeout_s": 20}],
    "inputs": [{"name": "input inventory cache", "path": "{source_cache}", "tree": "lc0-inventory", "digest": "{inventory_digest}"}, {"name": "reference net", "path": "{net}"}]
  },
  "task": {
    "split": {"total": "split_records", "count": "shards", "unit": "records"},
    "label": "sample-lc0-calibration:{shard}",
    "outputs": ["{output_dir}/{task_name}.pairs.jsonl"],
    "command": ".venv/bin/python tools/score/lc0_calibration.py sample --input {task_input} --inventory {task_inventory} --output {output_dir}/{task_name}.pairs.jsonl --engine {engine} --net {net} --net-option nnue_file --threads {threads} --hash {hash} --max-records {task_records} --min-ply {min_ply} {quiet_only_arg} --sample-modulus {sample_modulus} --shard-count 1 --shard-index 0",
    "progress": {"unit": "records", "log_regex": "read=(?P<done>\\d+)", "series": [{"name": "read", "field": "done", "x": "done", "scale": "linear"}]}
  }
}
