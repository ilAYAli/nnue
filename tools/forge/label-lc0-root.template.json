{
  "schema": "forge.template.v1",
  "name": "label-lc0-root",
  "kind": "label",
  "description": "Convert LC0 V6 training records to BulletFormat using corrected LC0 root-Q targets",
  "run_name": "label-lc0-root-{input_stem}-{timestamp}",
  "work_dir": "{labeler}",
  "path_maps": {
    "macos": {
      "~/.cache/forge": "~/Library/Caches/forge"
    }
  },
  "chunking": {
    "initial_units": 5000,
    "min_chunks_per_slot": 0,
    "signature_version": "task-input-v1"
  },
  "parameters": {
    "chunk_time_seconds": {
      "type": "int",
      "default": 300,
      "help": "Target wall-clock seconds per adaptively sized chunk"
    },
    "labeler": {
      "type": "source",
      "default": "nnue",
      "include": ["tools/score/**", "tools/lib/**", "tools/posgen/**", "tools/tests/test_streaming_labeling.py"],
      "exclude": ["**/__pycache__/**", "**/.venv/**", "**/target/**"],
      "output": "~/.cache/forge/sources/nnue-{digest12}",
      "help": "Configured source alias or directory containing the labeling scripts"
    },
    "input": {
      "required": true,
      "path_context": "shared_home",
      "help": "Coordinator directory containing LC0 training.* records"
    },
    "output": {
      "required": true,
      "path_context": "shared_home",
      "help": "Final merged BulletFormat output"
    },
    "max_records": {
      "type": "int",
      "default": 0,
      "help": "Global raw input-record limit"
    },
    "split_records": {
      "type": "int",
      "default": 1600,
      "help": "Positive planner placeholder; max_records=0 assigns all input files to the requested shards"
    },
    "min_ply": {
      "type": "int",
      "default": 16,
      "help": "Minimum game ply"
    },
    "quiet_only": {
      "type": "bool",
      "default": true,
      "help": "Keep only quiet positions outside check"
    },
    "shards": {
      "type": "int",
      "help": "Override the adaptively calculated task count"
    }
  },
  "requirements": {
    "python_min": "3.11",
    "sources": [
      {
        "name": "nnue-labeler",
        "path": "{labeler}",
        "digest": "{labeler_digest}",
        "install_timeout_s": 300,
        "install": [
          "PYTHON=python3; test ! -x /opt/homebrew/bin/python3 || PYTHON=/opt/homebrew/bin/python3; test -x .venv/bin/python || \"$PYTHON\" -m venv .venv; .venv/bin/python -m pip install -q python-chess"
        ],
        "probe": [
          ".venv/bin/python -m unittest tools.tests.test_streaming_labeling"
        ]
      }
    ],
    "inputs": [
      {
        "name": "input inventory cache",
        "path": "{source_cache}",
        "tree": "lc0-inventory",
        "digest": "{inventory_digest}"
      }
    ]
  },
  "task": {
    "split": {
      "total": "split_records",
      "count": "shards",
      "unit": "records"
    },
    "label": "label-lc0-root:{shard}",
    "outputs": [
      "{output_dir}/{task_name}.bullet",
      "{output_dir}/{task_name}.stats.json"
    ],
    "command": ".venv/bin/python tools/score/label.py --input {task_input} --inventory {task_inventory} --output {output_dir}/{task_name}.bullet --stats {output_dir}/{task_name}.stats.json --score-source lc0-root --max-records {task_records} --min-ply {min_ply} {quiet_only_arg} --shard-count 1 --shard-index 0",
    "progress": {
      "unit": "records",
      "log_regex": "read=(?P<done>\\d+) selected=(?P<selected>\\d+) written=(?P<output>\\d+) rate=(?P<rate>[0-9.]+)/s",
      "output_unit": "positions",
      "series": [
        {"name": "read", "field": "done", "x": "done", "scale": "linear"},
        {"name": "selected", "field": "selected", "x": "done", "scale": "linear"},
        {"name": "written", "field": "output", "x": "done", "scale": "linear"}
      ]
    }
  },
  "finalize": {
    "type": "bullet-labels",
    "output": "{output}",
    "inventory_digest": "{inventory_digest}"
  }
}
