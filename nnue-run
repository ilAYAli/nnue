def repo_root() -> Path:
    return Path(__file__).resolve().parent


def now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def read_json(path: Path) -> dict[str, Any]:
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise SystemExit(f"{path}: expected a JSON object")
    return data


def bool_env(value: Any) -> str:
    if isinstance(value, bool):
        return "1" if value else "0"
    if isinstance(value, int):
        return "1" if value else "0"
    text = str(value).strip().lower()
    return "1" if text in {"1", "true", "yes", "on"} else "0"


def merge_defaults(defaults: dict[str, Any], overrides: Any, *, path: Path, name: str) -> dict[str, Any]:
    if overrides is None:
        return dict(defaults)
    if not isinstance(overrides, dict):
        raise SystemExit(f"{path}: {name} must be an object")
    unknown = sorted(set(overrides) - set(defaults))
    if unknown:
        raise SystemExit(f"{path}: {name} unknown field(s): {', '.join(unknown)}")
    merged = dict(defaults)
    merged.update(overrides)
    return merged


def resolve_reference(reference: str | Path, *, base_path: Path) -> Path:
    raw = Path(os.path.expandvars(str(reference))).expanduser()
    if raw.is_absolute():
        return raw.resolve()
    return (base_path.parent / raw).resolve()


def load_architecture(config: dict[str, Any], *, path: Path) -> dict[str, Any]:
    if "architecture" not in config:
        raise SystemExit(f"{path}: compact NNUE config requires architecture")
    reference = config["architecture"]
    if isinstance(reference, dict):
        architecture = dict(reference)
    elif isinstance(reference, str) and reference.strip():
        architecture = read_json(resolve_reference(reference, base_path=path))
    else:
        raise SystemExit(f"{path}: architecture must be a path or object")
    unknown = sorted(set(architecture) - ARCHITECTURE_KEYS)
    if unknown:
        raise SystemExit(
            f"{path}: architecture unknown field(s): {', '.join(unknown)}"
        )
    required = {
        "name",
        "mode",
        "hidden",
        "l2_size",
        "input_buckets",
        "feature_channels",
        "output_buckets",
    }
    missing = sorted(required - set(architecture))
    if missing:
        raise SystemExit(f"{path}: architecture missing field(s): {', '.join(missing)}")
    return architecture


def enyo_network_size(architecture: dict[str, Any]) -> int:
    features = (
        int(architecture["input_buckets"])
        * int(architecture["feature_channels"])
        * ENYO_SQUARES
    )
    hidden = int(architecture["hidden"])
    l2_size = int(architecture["l2_size"])
    output_buckets = int(architecture["output_buckets"])
    l3_size = ENYO_L3
    l1_size = 2 * hidden
    output_head_features = int(architecture.get("output_head_features", 0))
    return (
        features * hidden * 2
        + hidden * 2
        + l1_size * l2_size
        + l2_size * 4
        + l2_size * l3_size * 4
        + l3_size * 4
        + output_buckets * (l3_size + output_head_features) * 4
        + output_buckets * 4
    )


