def export_command(training: dict[str, Any], expected_size: int) -> str:
    net_id = str(training["net_id"])
    superbatches = int(training["superbatches"])
    return (
        f'src="runs/{{run}}/checkpoints/{net_id}-{superbatches}/quantised.bin"; '
        'dst="$HOME/assets/nets/{run}.nn"; '
        f"expected_size={expected_size}; "
        'ls -lh "$src"; '
        'actual=$(python3 -c \'import os, sys; print(os.path.getsize(sys.argv[1]))\' "$src"); '
        'if [ "$actual" -lt "$expected_size" ]; then '
        'echo "ERROR: $src is $actual bytes, expected at least $expected_size" >&2; '
        "exit 1; "
        "fi; "
        'if [ "$actual" -ne "$expected_size" ]; then '
        'echo "Trimming Bullet padding: $actual -> $expected_size bytes"; '
        "fi; "
        'mkdir -p "$HOME/assets/nets"; '
        'head -c "$expected_size" "$src" > "$dst"; '
        'python3 -c \'import os, sys; print("%s %d bytes" % '
        '(sys.argv[1], os.path.getsize(sys.argv[1])))\' "$dst"'
    )


def smoke_command(validation: dict[str, Any]) -> str:
    return (
        "printf 'uci\\nisready\\n"
        f"setoption name nnue_file value {validation['candidate_net']}\\n"
        f"position fen {validation['smoke_fen']}\\n"
        "go depth 1\\nquit\\n' "
        f"| {validation['engine']}"
    )


def smoke_sprt_command(validation: dict[str, Any]) -> str:
    return (
        "bash -lc '"
        "tmp=$(mktemp); "
        f"sprt --reference {validation['engine']} "
        f"--candidate {validation['engine']} "
        f"--reference-uci nnue_file={validation['reference_net']} "
        f"--candidate-uci nnue_file={validation['candidate_net']} "
        f"--concurrency {validation['smoke_concurrency']} "
        f"--games {validation['smoke_games']} "
        '2>&1 | tee "$tmp"; '
        "rc=$PIPESTATUS; "
        'final=$(grep -E "^\\[[[:space:]]*[0-9]+/" "$tmp" | tail -1); '
        'rm -f "$tmp"; '
        'echo "Final SPRT line: $final"; '
        'if [ "$rc" -ne 0 ]; then exit "$rc"; fi; '
        'los=$(printf "%s\\n" "$final" '
        '| sed -n "s/.*LOS[[:space:]]*\\([0-9.]*\\)%.*/\\1/p"); '
        'if [ -z "$los" ]; then echo "ERROR: no LOS in SPRT output"; exit 1; fi; '
        "if ! python3 -c '\\''import sys; "
        "los=float(sys.argv[1]); threshold=float(sys.argv[2]); "
        "sys.exit(0 if los >= threshold else 1)'\\'' "
        f' "$los" "{validation["smoke_los_threshold"]}"; then '
        'echo "ERROR: smoke SPRT was negative (LOS $los%)"; exit 1; '
        "fi'"
    )


def main_sprt_command(validation: dict[str, Any]) -> str:
