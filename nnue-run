#!/usr/bin/env bash
set -Eeuo pipefail

# Thin native NNUE loop:
#   ./nnue-run iterate   train, gate, SPRT, bump build.json on success, stop on failure
#   ./nnue-run iterate --full-sprt-first  run full SPRT directly for iteration 1 only
#   ./nnue-run plan      show resolved tools/bullet/train plan
#   ./nnue-run train     data + train + export
#   ./nnue-run gates     startpos + static eval + move gate
#   ./nnue-run sprt      candidate vs reference games
#   ./nnue-run status    print current run/reference and latest logs

cmd=iterate
SOLO=0
FULL_SPRT_FIRST=0
for arg in "$@"; do
  case "$arg" in
    --solo) SOLO=1 ;;
    --full-sprt-first) FULL_SPRT_FIRST=1 ;;
    iterate|plan|train|gates|sprt|status|help|-h|--help) cmd=$arg ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

BUILD=${BUILD:-build.json}
ARCH=${ARCH:-architecture.json}
DEFAULTS=${DEFAULTS:-defaults.json}
PYTHON=${PYTHON:-.venv/bin/python}
CRUCIBLE=${CRUCIBLE:-crucible}

ENGINE=${ENGINE:-$HOME/assets/engines/enyo_91ede5f}
REFERENCE_NET=${REFERENCE_NET:-}
CASES=${CASES:-runs/lichess-inacc-miss-blunder-20260612/native760_vs_native123_net_value_bad_move_gate.jsonl}

ROWS=${ROWS:-50000}
SMOKE_GAMES=${SMOKE_GAMES:-400}
SMOKE_FAIL_ELO=${SMOKE_FAIL_ELO:--15.0}
SMOKE_FAIL_LLR=${SMOKE_FAIL_LLR:--0.20}
GAMES=${GAMES:-3000}
CONCURRENCY=${CONCURRENCY:-8}
THREADS=${THREADS:-1}
ITERATIONS=${ITERATIONS:-999}
SPRT_ELO0=${SPRT_ELO0:-0.0}
SPRT_ELO1=${SPRT_ELO1:-3.0}
SPRT_ALPHA=${SPRT_ALPHA:-0.10}
SPRT_BETA=${SPRT_BETA:-0.10}
SPRT_INFRA_RETRIES=${SPRT_INFRA_RETRIES:-5}

# Loose broken-net gates. These stop obviously bad exports/training before SPRT.
# They are not promotion criteria; SPRT decides whether an iteration is accepted.
MAX_STARTPOS_CP=${MAX_STARTPOS_CP:-300}    # Startpos outside +/-300cp usually means scale/sign/export trouble.
MAX_MAE=${MAX_MAE:-600}                    # Sane native runs are around 300cp on 50k rows; 600+ is suspect.
MIN_SIGN=${MIN_SIGN:-55}                   # 50% is chance; below 55% barely knows which side is better.
MIN_CORR=${MIN_CORR:-0.20}                 # Near zero means eval is mostly unrelated to target.
MAX_ABS_BIAS=${MAX_ABS_BIAS:-300}          # Hundreds of cp offset indicates global bias/scale/sign trouble.
MIN_SLOPE=${MIN_SLOPE:-0.10}               # Near zero means dead/flat eval.
MOVE_GATE_STRICT=${MOVE_GATE_STRICT:-0}    # 0 reports move gate; 1 also fails on worse selected-move counts.

EVENT_HOOK=${EVENT_HOOK:-tools/events/nnue_event_ntfy.sh}
NNUE_NTFY=${NNUE_NTFY:-1}

run=
continue_from=
reference_name=
run_dir=
log_dir=
candidate_net=
data_file=
reference_net=
train_build=
summary_file=
last_sprt_elo=
last_sprt_llr=
last_sprt_line=
last_sprt_command=
last_sprt_log=

fail() {
  echo "FAILED: $*" >&2
  notify fail "${2:-n/a}" "$*" "" 1
  print_summary || true
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

require_crucible_idle() {
  [[ "$SOLO" == 1 ]] && return 0
  command -v "$CRUCIBLE" >/dev/null 2>&1 || fail "missing command: $CRUCIBLE" "${1:-sprt}"

  local status_json busy
  status_json=$("$CRUCIBLE" status --json) || {
    [[ -n "$status_json" ]] && jq -e . >/dev/null <<< "$status_json" \
      || fail "could not read Crucible active status" "${1:-sprt}"
  }
  busy=$(jq -r '
    (.runs // [])
    | map(select(((.tasks // 0) > 0) and ((.done // 0) < (.tasks // 0))))
    | .[0]? as $run
    | if $run == null then empty else
        [
          ($run.run // "unknown"),
          ($run.state // "active"),
          (($run.progress_fields // []) | join(" "))
        ] | @tsv
      end
  ' <<< "$status_json") || fail "could not read Crucible active status" "${1:-sprt}"

  [[ -z "$busy" ]] && return 0

  local busy_run busy_state busy_progress
  IFS=$'	' read -r busy_run busy_state busy_progress <<< "$busy"
  local message="refusing to start Crucible SPRT while Crucible is busy: $busy_run"
  [[ -z "$busy_state" || "$busy_state" == "null" ]] || message+=" $busy_state"
  [[ -z "$busy_progress" || "$busy_progress" == "null" ]] || message+=" $busy_progress"
  fail "$message" "${1:-sprt}"
}

json() {
  jq -r "$1" "$BUILD"
}

abs_path() {
  case "$1" in
    ~/*) printf '%s/%s\n' "$HOME" "${1#~/}" ;;
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PWD" "$1" ;;
  esac
}

net_for_name_or_path() {
  [[ -z "$1" || "$1" == "null" ]] && return 1
  case "$1" in
    ~/*|/*|*.nn) abs_path "$1" ;;
    *) echo "$HOME/assets/nets/$1.nn" ;;
  esac
}

previous_run_name() {
  if [[ "$1" =~ ^(.*-v|.*v)([0-9]+)$ ]]; then
    local n=$((10#${BASH_REMATCH[2]} - 1))
    (( n >= 0 )) || return 1
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$n"
  elif [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    local patch=$((10#${BASH_REMATCH[4]} - 1))
    (( patch >= 0 )) || return 1
    printf '%s%d.%d.%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))" "$patch"
  else
    return 1
  fi
}

load_config() {
  run=$(json '.run')
  continue_from=$(json '.continue_from // empty')
  init_net=$(json '.init_net // empty')
  reference_name=$(json '.reference // empty')
  if [[ -n "$init_net" && -n "$continue_from" ]]; then
    fail "init_net conflicts with continue_from; use reference to override the SPRT reference" config
  fi
  if [[ -z "$continue_from" ]]; then
    continue_from=$(previous_run_name "$run") || fail "cannot infer previous run from run=$run" config
  fi
  run_dir="runs/$run"
  log_dir="$run_dir/logs"
  candidate_net="$HOME/assets/nets/$run.nn"
  data_file="data/bullet/$run.bullet"
  mkdir -p "$log_dir" runs/logs
  local ref_source="${REFERENCE_NET:-${reference_name:-$continue_from}}"
  reference_net=$(net_for_name_or_path "$ref_source")
  summary_file=${summary_file:-runs/logs/nnue-run-iterate-$(date +%Y%m%d_%H%M%S).txt}
}

reference_label() {
  printf '%s\n' "${REFERENCE_NET:-${reference_name:-$continue_from}}"
}

training_build() {
  train_build="$run_dir/build.resolved.json"
  jq --arg prev "$continue_from" \
    'if (.init_net // "") != "" then del(.continue_from) else .continue_from = $prev end
     | del(.reference)
     | del(.changed_variables.reference)' \
    "$BUILD" > "$train_build"
  printf '%s\n' "$train_build"
}

notify() {
  local event=$1 phase=$2 message=$3 log=${4:-} user_notify=${5:-0}
  [[ "$NNUE_NTFY" == 1 ]] || return 0
  [[ -x "$EVENT_HOOK" ]] || return 0
  local payload
  payload=$(jq -cn \
    --arg event "$event" \
    --arg run "${run_dir:-runs/${run:-unknown}}" \
    --arg stage "$phase" \
    --arg status "$event" \
    --arg message "$message" \
    --arg log "$log" \
    --arg summary "${summary_file:-}" \
    --argjson user_notify "$user_notify" \
    '{
      event:$event,
      run:$run,
      stage:$stage,
      status:$status,
      message:$message,
      log:$log,
      summary:$summary,
      user_notify:$user_notify,
      critical_failure:($event == "fail"),
      good_news:($event == "done" and $user_notify)
    }')
  NNUE_NTFY_EVENTS=${NNUE_NTFY_EVENTS:-done,fail,test} \
  NNUE_AI_STDIN_EVENTS=${NNUE_AI_STDIN_EVENTS:-phase_done,done,fail} \
  NNUE_USER_NOTIFY_GENERIC=${NNUE_USER_NOTIFY_GENERIC:-0} \
  NNUE_RUN_EVENT_JSON=$payload "$EVENT_HOOK" >/dev/null 2>&1 || true
}

section() {
  printf '\n\n  \033[1m▶ %s\033[0m\n' "$1"
  printf '  ────────────────────────────────────────\n'
}

result_pass() {
  printf '  │ %-8s %10s  %s %s\n' "$1" "$2" "$3" "$4"
}

show_config() {
  load_config
  cat <<EOF
run=$run
continue_from=${continue_from:-}
reference=$(reference_label)
engine=$ENGINE
reference_net=$reference_net
candidate_net=$candidate_net
data=$data_file
logs=$log_dir
EOF
}

float_ge() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a >= b) }'; }
float_le() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a <= b) }'; }
float_lt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a < b) }'; }
float_gt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
abs_float_le() { awk -v a="$1" -v b="$2" 'BEGIN { if (a < 0) a = -a; exit !(a <= b) }'; }

sprt_h1_passed() {
  local value upper
  value=$(sed -nE 's/^[[:space:]]*([+-]?[0-9]+([.][0-9]+)?)\/.*/\1/p' <<< "$1")
  upper=$(sed -nE 's/^[[:space:]]*[+-]?[0-9]+([.][0-9]+)?\/([+-]?[0-9]+([.][0-9]+)?).*/\2/p' <<< "$1")
  [[ -n "$value" && -n "$upper" ]] || return 2
  float_ge "$value" "$upper"
}

sprt_llr_value() {
  local value
  value=$(sed -nE 's/^[[:space:]]*([+-]?[0-9]+([.][0-9]+)?)\/.*/\1/p' <<< "$1")
  [[ -n "$value" ]] || return 2
  printf '%s\n' "$value"
}

smoke_sprt_failed() {
  local elo=$1 llr=$2
  local llr_value
  llr_value=$(sprt_llr_value "$llr") || return 2
  if float_le "$elo" "$SMOKE_FAIL_ELO"; then
    return 0
  fi
  if float_lt "$elo" 0 && float_le "$llr_value" "$SMOKE_FAIL_LLR"; then
    return 0
  fi
  return 1
}

full_sprt_label=
full_sprt_pass() {
  if sprt_h1_passed "$last_sprt_llr"; then
    full_sprt_label="H1 reached"
    return 0
  fi

  local llr_value
  llr_value=$(sprt_llr_value "$last_sprt_llr") || fail "could not parse SPRT LLR: $last_sprt_llr" sprt
  if float_gt "$last_sprt_elo" 0 && float_gt "$llr_value" 0; then
    full_sprt_label="positive at cap"
    return 0
  fi
  return 1
}

quote_cmd() {
  printf '%q ' "$@"
  printf '\n'
}

ensure_git_identity() {
  git config user.name "Petter Wahlman"
  git config user.email "petter@wahlman.no"
}

metric() {
  awk -F= -v key="$1" '$1 == key { gsub(/%/, "", $2); print $2 }' "$2" | tail -1
}

plan() {
  load_config
  tools/bullet/train plan --build "$BUILD" --arch "$ARCH" --defaults "$DEFAULTS"
}

train() {
  load_config
  if [[ "${FORCE:-0}" != 1 ]]; then
    local log="$log_dir/01-train-export.log"
    local model_net="$run_dir/model.nn"
    if [[ -s "$model_net" ]]; then
      section train
      if cmp -s "$model_net" "$candidate_net"; then
        echo "SKIP train/export: $candidate_net already matches $model_net" | tee -a "$log"
      else
        echo "INSTALL completed model: $model_net -> $candidate_net" | tee -a "$log"
        install -D -m 0644 "$model_net" "$candidate_net"
      fi
      notify phase_done train "training/export resumed for $run: installed $candidate_net" "$log" 0
      return 0
    fi
    if [[ -s "$candidate_net" ]]; then
      section train
      echo "SKIP train/export: $candidate_net exists (FORCE=1 to rebuild)" | tee -a "$log"
      notify phase_done train "training/export skipped for $run: $candidate_net exists" "$log" 0
      return 0
    fi
  fi
  local build_for_train
  build_for_train=$(training_build)
  local train_args=(all --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS")
  if [[ "${FORCE:-0}" == 1 ]]; then
    train_args+=(--force)
  fi
  notify phase_start train "training $run" "$log_dir/01-train-export.log" 0
  section plan
  tools/bullet/train plan --build "$build_for_train" --arch "$ARCH" --defaults "$DEFAULTS" | tee "$log_dir/00-plan.log" || fail "plan failed for $run" plan
  section train
  tools/bullet/train "${train_args[@]}" \
    2>&1 | tee "$log_dir/01-train-export.log" \
    || fail "train/export failed for $run" train
  notify phase_done train "training/export passed for $run" "$log_dir/01-train-export.log" 0
}

startpos_gate() {
  load_config
  notify phase_start startpos "startpos gate $run" "$log_dir/02-startpos.log" 0
  section startpos
  show_config
  [[ -x "$ENGINE" ]] || fail "missing engine: $ENGINE" startpos
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" startpos

  local log="$log_dir/02-startpos.log"
  printf 'uci\nsetoption name nnue_file value %s\nisready\nposition startpos\ngo depth 3\nquit\n' "$candidate_net" \
    | "$ENGINE" | tee "$log"

  grep -q 'evaluator=native-nnue' "$log" || fail "engine did not load native-nnue" startpos

  local hidden buckets channels cp
  hidden=$(jq -r .hidden "$ARCH")
  buckets=$(jq -r '.runtime_input_buckets // .input_buckets' "$ARCH")
  channels=$(jq -r .feature_channels "$ARCH")
  grep -q "hidden=$hidden" "$log" || fail "hidden mismatch, expected $hidden" startpos
  grep -q "input_buckets=$buckets" "$log" || fail "input_buckets mismatch, expected $buckets" startpos
  grep -q "feature_channels=$channels" "$log" || fail "feature_channels mismatch, expected $channels" startpos

  cp=$(awk '/info depth 3 / { for (i = 1; i <= NF; i++) if ($i == "cp") print $(i + 1) }' "$log" | tail -1)
  [[ -n "$cp" ]] || fail "startpos depth 3 had no cp score" startpos
  abs_float_le "$cp" "$MAX_STARTPOS_CP" || fail "startpos cp $cp outside +/-$MAX_STARTPOS_CP" startpos
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  startpos\n'
  result_pass "cp" "$cp" "|cp| <" "$MAX_STARTPOS_CP"
  printf '  └─────────────────────────────────────\n'
  notify phase_done startpos "startpos passed for $run: cp=$cp" "$log" 0
}

static_gate() {
  load_config
  notify phase_start static_eval "static eval gate $run" "$log_dir/03-static-eval.log" 0
  section static_eval
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" static_eval
  [[ -f "$data_file" ]] || fail "missing data: $data_file" static_eval
  local log="$log_dir/03-static-eval.log"
  "$PYTHON" tools/validate/eval_dataset.py \
    --net "$candidate_net" --data "$data_file" --rows "$ROWS" \
    --batch-size 4096 --device cpu --buckets 2>&1 | tee "$log"
  local mae sign corr bias slope
  mae=$(metric mae "$log")
  sign=$(metric sign "$log")
  corr=$(metric corr "$log")
  bias=$(metric bias "$log")
  slope=$(metric slope "$log")
  [[ -n "$mae" && -n "$sign" && -n "$corr" && -n "$bias" && -n "$slope" ]] || fail "missing static eval metric" static_eval
  float_le "$mae" "$MAX_MAE" || fail "MAE $mae > $MAX_MAE" static_eval
  float_ge "$sign" "$MIN_SIGN" || fail "sign $sign < $MIN_SIGN" static_eval
  float_ge "$corr" "$MIN_CORR" || fail "corr $corr < $MIN_CORR" static_eval
  abs_float_le "$bias" "$MAX_ABS_BIAS" || fail "bias $bias outside +/-$MAX_ABS_BIAS" static_eval
  float_ge "$slope" "$MIN_SLOPE" || fail "slope $slope < $MIN_SLOPE" static_eval
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  static_eval\n'
  result_pass "mae" "$mae" "<" "$MAX_MAE"
  result_pass "sign" "$sign" ">" "$MIN_SIGN"
  result_pass "corr" "$corr" ">" "$MIN_CORR"
  result_pass "bias" "$bias" "|b| <" "$MAX_ABS_BIAS"
  result_pass "slope" "$slope" ">" "$MIN_SLOPE"
  printf '  └─────────────────────────────────────\n'
  notify phase_done static_eval "static_eval passed for $run: mae=$mae sign=$sign corr=$corr bias=$bias slope=$slope" "$log" 0
}

move_gate() {
  load_config
  notify phase_start move_gate "move gate $run" "$log_dir/04-move-gate.log" 0
  section move_gate
  [[ -f "$reference_net" && -f "$candidate_net" && -f "$CASES" ]] || fail "missing gate prerequisites" move_gate
  local log="$log_dir/04-move-gate.log"
  local summary="$run_dir/move_gate.summary.json"
  "$PYTHON" tools/validate/eval_move_gate.py \
    --cases "$CASES" --engine "$ENGINE" --reference-net "$reference_net" \
    --candidate-net "$candidate_net" --threads 1 --hash 64 \
    --summary-json "$summary" --output "$run_dir/move_gate.jsonl" 2>&1 | tee "$log"
  local ref cand fixed regressed
  ref=$(jq -r .baseline_prefers_best "$summary")
  cand=$(jq -r .candidate_prefers_best "$summary")
  fixed=$(jq -r .fixed "$summary")
  regressed=$(jq -r .regressed "$summary")
  echo "move_gate reference_prefers_best=$ref candidate_prefers_best=$cand fixed=$fixed regressed=$regressed"
  if [[ "$MOVE_GATE_STRICT" == 1 ]]; then
    (( cand >= ref )) || fail "move gate candidate_prefers_best $cand < reference $ref" move_gate
    (( fixed > regressed )) || fail "move gate fixed $fixed <= regressed $regressed" move_gate
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  move_gate\n'
  result_pass "candidate" "$cand" "reference" "$ref"
  result_pass "fixed" "$fixed" "regressed" "$regressed"
  printf '  └─────────────────────────────────────\n'
  notify phase_done move_gate "move_gate passed for $run: candidate=$cand reference=$ref fixed=$fixed regressed=$regressed" "$log" 0
}

gates() {
  startpos_gate
  static_gate
  move_gate
}

crucible_run_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE 's/.* --run ([^ ]+).*/\1/p' "$log" | tail -1
}

command_from_log() {
  local log=$1
  [[ -f "$log" ]] || return 1
  sed -nE 's/^\+ //p' "$log" | head -1
}

read_crucible_sprt_status() {
  local crucible_run=$1 status_json state fields
  status_json=$("$CRUCIBLE" status "$crucible_run" --json) || return 1
  state=$(jq -r '.state // empty' <<< "$status_json") || return 1
  case "$state" in
    done|ok|completed) ;;
    *) return 1 ;;
  esac
  fields=$(jq -r '.progress_fields // [] | join(" ")' <<< "$status_json") || return 1
  last_sprt_elo=$(jq -r '.progress_fields[]? | select(startswith("elo=")) | sub("^elo="; "") | sub("^\\+"; "")' <<< "$status_json" | tail -1)
  last_sprt_llr=$(jq -r '.progress_fields[]? | select(startswith("llr=")) | sub("^llr="; "")' <<< "$status_json" | tail -1)
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Crucible $crucible_run $fields"
}

read_completed_crucible_sprt_log() {
  local crucible_run=$1 line games done total
  [[ -f "$last_sprt_log" ]] || return 1
  line=$(grep -E 'games=[0-9]+/[0-9]+.*elo=.*llr=' "$last_sprt_log" | tail -1) || return 1
  games=$(sed -nE 's/.*games=([0-9]+)\/([0-9]+).*/\1 \2/p' <<< "$line")
  [[ -n "$games" ]] || return 1
  read -r done total <<< "$games"
  [[ "$done" == "$total" ]] || return 1
  last_sprt_elo=$(sed -nE 's/.*elo=\+?([^ ]+).*/\1/p' <<< "$line")
  last_sprt_llr=$(sed -nE 's/.*llr=([^ ]+( [^ ]+)?) .*/\1/p' <<< "$line")
  [[ -n "$last_sprt_elo" && -n "$last_sprt_llr" ]] || return 1
  last_sprt_line="Crucible $crucible_run $line"
}

retry_crucible_sprt() {
  local crucible_run=$1 attempt=0 rc=1
  while (( SPRT_INFRA_RETRIES <= 0 || attempt < SPRT_INFRA_RETRIES )); do
    attempt=$((attempt + 1))
    printf 'retrying Crucible SPRT infrastructure: %s attempt %d\n' "$crucible_run" "$attempt" | tee -a "$last_sprt_log"

    set +e
    "$CRUCIBLE" resume "$crucible_run" --verify 2>&1 | tee -a "$last_sprt_log"
    rc=${PIPESTATUS[0]}
    set -e
    if read_crucible_sprt_status "$crucible_run" || read_completed_crucible_sprt_log "$crucible_run"; then
      return 0
    fi

    set +e
    "$CRUCIBLE" retry "$crucible_run" --verify 2>&1 | tee -a "$last_sprt_log"
    rc=${PIPESTATUS[0]}
    set -e
    if read_crucible_sprt_status "$crucible_run" || read_completed_crucible_sprt_log "$crucible_run"; then
      return 0
    fi
  done
  return 1
}

run_sprt_once() {
  local label=$1 sprt_games=$2 stage=$3
  last_sprt_log="$log_dir/05-${label}-${sprt_games}.log"
  notify phase_start "$stage" "SPRT $label $run vs $(reference_label)" "$last_sprt_log" 0
  section "$label"

  if [[ "$SOLO" != 1 ]]; then
    local forge="$HOME/code/cpp/chess/crucible/scripts/forge"
    local engine_hash="${ENGINE##*/}"
    local crucible_run
    crucible_run=$(crucible_run_from_log "$last_sprt_log" || true)
    if [[ -n "$crucible_run" ]]; then
      last_sprt_command=$(command_from_log "$last_sprt_log" || true)
      if read_crucible_sprt_status "$crucible_run" || read_completed_crucible_sprt_log "$crucible_run"; then
        return 0
      fi
      retry_crucible_sprt "$crucible_run" \
        || fail "Crucible SPRT infrastructure failed for $run ($crucible_run); rerun ./nnue-run iterate to retry the same run" sprt
      return 0
    fi

    require_crucible_idle "$stage"
    crucible_run="${run}-${label}-${sprt_games}-$(date +%Y%m%d-%H%M%S)"
    engine_hash="${engine_hash#enyo_}"
    [[ -x "$forge" ]] || fail "missing forge: $forge" sprt
    local forge_cmd=(
      "$forge" nnue "$engine_hash"
      --candidate-nnue "$candidate_net"
      --reference-nnue "$reference_net"
      --verify
      --run "$crucible_run"
    )
    local hypothesis
    hypothesis=$(json '.hypothesis // empty')
    [[ -z "$hypothesis" ]] || forge_cmd+=(--comment "$hypothesis")
    forge_cmd+=(
      --
      --games "$sprt_games"
      --elo0 "$SPRT_ELO0"
      --elo1 "$SPRT_ELO1"
      --alpha "$SPRT_ALPHA"
      --beta "$SPRT_BETA"
    )
    last_sprt_command=$(quote_cmd "${forge_cmd[@]}")
    if ! "${forge_cmd[@]}" 2>&1 | tee "$last_sprt_log"; then
      retry_crucible_sprt "$crucible_run" \
        || fail "Crucible SPRT infrastructure failed for $run ($crucible_run); rerun ./nnue-run iterate to retry the same run" sprt
      return 0
    fi

    read_crucible_sprt_status "$crucible_run" \
      || read_completed_crucible_sprt_log "$crucible_run" \
      || fail "could not parse completed Crucible SPRT result for $crucible_run" sprt
    return 0
  fi

  local sprt_cmd=(
    sprt
    --concurrency "$CONCURRENCY"
    --threads "$THREADS"
    --reference "$ENGINE"
    --candidate "$ENGINE"
    --reference-uci "nnue_file=$reference_net"
    --candidate-uci "nnue_file=$candidate_net"
    --games "$sprt_games"
    --elo0 "$SPRT_ELO0"
    --elo1 "$SPRT_ELO1"
    --alpha "$SPRT_ALPHA"
    --beta "$SPRT_BETA"
  )
  last_sprt_command=$(quote_cmd "${sprt_cmd[@]}")
  "${sprt_cmd[@]}" \
    2>&1 | tee "$last_sprt_log" \
    || fail "SPRT command failed for $run" sprt

  last_sprt_line=$(grep -E '^\[[[:space:]]*[0-9]+/[0-9]+\] Elo' "$last_sprt_log" | tail -1)
  [[ -n "$last_sprt_line" ]] || fail "could not parse SPRT output" sprt
  last_sprt_elo=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "Elo") { print $(i + 1); exit } }' <<< "$last_sprt_line")
  last_sprt_llr=$(sed -nE 's/.*[Ll][Ll][Rr][ =:]+([+-]?[0-9.]+\/[+-]?[0-9.]+).*/\1/p' <<< "$last_sprt_line" | tail -1)
  [[ -n "$last_sprt_elo" ]] || fail "could not parse SPRT Elo" sprt
  [[ -n "$last_sprt_llr" ]] || fail "could not parse SPRT LLR" sprt
}

sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  run_sprt_once smoke "$SMOKE_GAMES" sprt_smoke
  if sprt_h1_passed "$last_sprt_llr"; then
    printf '  ┌─────────────────────────────────────\n'
    printf '  │ \033[1;32m✓ PASS\033[0m  smoke (H1 reached)\n'
    result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
    printf '  └─────────────────────────────────────\n'
    notify phase_done sprt "SPRT smoke passed for $run: $last_sprt_line" "$last_sprt_log" 0
    return 0
  fi
  local smoke_rc
  if smoke_sprt_failed "$last_sprt_elo" "$last_sprt_llr"; then
    return 1
  else
    smoke_rc=$?
    if (( smoke_rc == 2 )); then
      fail "could not parse smoke SPRT LLR: $last_sprt_llr" sprt
    fi
  fi
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;33m→ CONTINUE\033[0m  smoke → full SPRT\n'
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify phase_done sprt_smoke "SPRT smoke inconclusive for $run: $last_sprt_line" "$last_sprt_log" 0

  run_sprt_once sprt "$GAMES" sprt
  full_sprt_pass || return 1
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}
full_sprt_gate() {
  load_config
  section sprt
  show_config
  [[ -f "$reference_net" ]] || fail "missing reference net: $reference_net" sprt
  [[ -f "$candidate_net" ]] || fail "missing candidate net: $candidate_net" sprt

  run_sprt_once sprt "$GAMES" sprt
  full_sprt_pass || return 1
  printf '  ┌─────────────────────────────────────\n'
  printf '  │ \033[1;32m✓ PASS\033[0m  sprt (%s)\n' "$full_sprt_label"
  result_pass "elo" "$last_sprt_elo" "llr" "$last_sprt_llr"
  printf '  └─────────────────────────────────────\n'
  notify phase_done sprt "SPRT passed for $run: $last_sprt_line" "$last_sprt_log" 0
}

next_run_name() {
  if [[ "$1" =~ ^(.*-v|.*v)([0-9]+)$ ]]; then
    printf '%s%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]} + 1))"
  elif [[ "$1" =~ ^(.+-)([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    printf '%s%d.%d.%d\n' "${BASH_REMATCH[1]}" "$((10#${BASH_REMATCH[2]}))" "$((10#${BASH_REMATCH[3]}))" "$((10#${BASH_REMATCH[4]} + 1))"
  else
    fail "cannot bump run name: $1" iterate
  fi
}

commit_and_bump_build_json() {
  local result=$1 accepted=$2 elo=$3 llr=$4 command=$5 details=$6
  local next next_base subject
  next=$(next_run_name "$accepted")
  if [[ "$result" == PASS ]]; then
    subject="${accepted}.nn: Elo ${elo},LLR ${llr}"
    next_base=$accepted
  else
    subject="fail: ${accepted}.nn: Elo ${elo},LLR ${llr}"
    next_base=${continue_from:-}
    [[ -n "$next_base" ]] || next_base=$(previous_run_name "$accepted") || return
  fi

  git commit --only \
    -m "$subject" \
    -m "Forge command:
$command

Result:
$details" \
    -- "$BUILD" "$ARCH" || return

  local tmp
  tmp=$(mktemp)
  jq \
    --arg run "$next" \
    --arg continue_from "$next_base" \
    '.run = $run
     | .continue_from = $continue_from
     | if ((.data.offset? | type) == "number") and ((.data.limit? | type) == "number") then
         .data.offset = (.data.offset + .data.limit)
       else
         .
       end
     | del(.reference)
     | del(.init_net)
     | del(.changed_variables.reference)' \
    "$BUILD" > "$tmp"
  mv "$tmp" "$BUILD"
  echo "updated $BUILD: run=$next"
}

bump_build_json() {
  commit_and_bump_build_json PASS "$@"
}

fail_build_json() {
  commit_and_bump_build_json FAIL "$@"
}

commit_failed_iteration() {
  fail_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-failed sprt}" \
    || fail "failed build.json commit failed for $run" iterate
  record_iteration FAIL "rejected; build.json advanced"
  notify fail iterate "rejected $run: ${last_sprt_line:-sprt failed}" "$summary_file" 1
  print_summary || true
  exit 1
}

record_iteration() {
  local result=$1
  local detail=$2
  {
    echo "$run vs $(reference_label): $result"
    echo "  $detail"
    [[ -n "${last_sprt_line:-}" ]] && echo "  $last_sprt_line"
  } >> "$summary_file"
}

print_summary() {
  [[ -f "${summary_file:-}" ]] || return 0
  section "iteration summary"
  cat "$summary_file"
  echo "summary_file=$summary_file"
}

iterate() {
  need jq
  need git
  ensure_git_identity
  for ((i = 1; i <= ITERATIONS; i++)); do
    load_config
    section "iteration $i"
    show_config
    notify phase_start iterate "starting iteration $i: $run" "$summary_file" 0
    if (( FULL_SPRT_FIRST == 1 && i == 1 )); then
      full_sprt_gate || commit_failed_iteration
    else
      train || fail "train failed for $run" train
      gates || fail "gates failed for $run" gates
      sprt_gate || commit_failed_iteration
    fi
    bump_build_json "$run" "$last_sprt_elo" "$last_sprt_llr" "$last_sprt_command" "${last_sprt_line:-passed sprt}" \
      || fail "build.json commit failed for $run" iterate
    record_iteration PASS "accepted; build.json advanced"
    notify done iterate "accepted $run: ${last_sprt_line:-sprt passed}" "$summary_file" 1
  done
  print_summary
}

status() {
  load_config
  show_config
  echo
  pgrep -af 'nnue-run|tools/bullet/train|enyo-bullet-spike|sprt|fastchess' || true
  echo
  find "$log_dir" -maxdepth 1 -type f 2>/dev/null | sort | tail -10
}

help() {
  cat <<'EOF'
Usage:
  ./nnue-run iterate   # main command: train, gate, SPRT, bump build.json on pass
  ./nnue-run iterate --full-sprt-first
  ./nnue-run plan
  ./nnue-run train
  ./nnue-run gates
  ./nnue-run sprt
  ./nnue-run sprt --solo
  ./nnue-run status

Useful overrides:
  ITERATIONS=5 ./nnue-run iterate
  ./nnue-run iterate --full-sprt-first  # first iteration skips train/gates/smoke
  REFERENCE_NET=$HOME/assets/nets/other.nn ./nnue-run sprt
  SMOKE_GAMES=400 SMOKE_FAIL_ELO=-15 SMOKE_FAIL_LLR=-0.20 ./nnue-run sprt
  GAMES=5000 CONCURRENCY=8 THREADS=1 ./nnue-run sprt
  FORCE=1 ./nnue-run train
  MOVE_GATE_STRICT=1 ./nnue-run gates
EOF
}

case "$cmd" in
  iterate) iterate ;;
  plan) plan ;;
  train) train ;;
  gates) gates ;;
  sprt) sprt_gate ;;
  status) status ;;
  help|-h|--help) help ;;
  *) fail "unknown command: $cmd" ;;
esac
