{
  "description": "Refresh replay-loss JSONL and child targets from the current synced Lichess loss logs. This is fixed-node normal NNUE target extraction; timed/history-sensitive rows stay diagnostic-only.",
  "experiment": "replay-loss-jsonl-latest-20260528",
  "create": {
    "name": "replay-loss-jsonl-latest-20260528",
    "backend": "replay-jsonl",
    "replay_logs": "~/code/cpp/chess/lichess/logs/loss",
    "replay": "~/local/bin/replay",
    "replay_candidate": "~/code/cpp/chess/assets/engines/reference",
    "replay_reference": "",
    "score_engine": "~/local/bin/stockfish",
    "replay_oracle_nodes": 200000,
    "replay_jobs": 8,
    "replay_move": 8,
    "replay_top_root_moves": 8,
    "replay_include_checks": true,
    "replay_include_captures": true,
    "replay_include_promotions": true,
    "replay_include_history_sensitive": false,
    "replay_max_moves_per_position": 16,
    "replay_min_score_gap": 0,
    "replay_output": "targets/replay-loss-20260528-latest/loss_replay.jsonl",
    "replay_stderr": "targets/replay-loss-20260528-latest/loss_replay.stderr",
    "replay_min_rows": 100,
    "replay_child_targets": "targets/replay-loss-20260528-latest/loss_replay_child_targets.jsonl",
    "replay_child_summary": "targets/replay-loss-20260528-latest/loss_replay_child_targets.summary.txt",
    "replay_child_min_groups": 100,
    "event_command": "$HOME/code/cpp/chess/nnue/tools/events/nnue_event_ntfy.sh"
  },
  "validation": {
    "expected_signal": [
      "replay rows should include the newly synced fkW8Ha8V loss",
      "history_sensitive must be zero for the normal NNUE corpus",
      "child target conversion must derive best_move from scored legal moves"
    ],
    "excluded_from_normal_training": [
      "timed-search-only mate blunders such as fkW8Ha8V move 29 Kh1"
    ]
  }
}
